{
  "$defs": {
    "ClaimType": {
      "enum": [
        "measurement_claim",
        "domain_interpretation",
        "descriptive_comparison",
        "inferential_comparison",
        "availability_claim",
        "alert_claim",
        "prior_or_literature_claim",
        "method_claim",
        "recommendation_hypothesis",
        "graft_retrospective_claim",
        "policy_or_boundary_statement",
        "visualization_caption"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "RegisteredStatement": {
      "additionalProperties": false,
      "properties": {
        "allowed_claim_types": {
          "items": {
            "$ref": "#/$defs/ClaimType"
          },
          "title": "Allowed Claim Types",
          "type": "array"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "statement_id": {
          "pattern": "^statement:[A-Za-z0-9._:-]+$",
          "title": "Statement Id",
          "type": "string"
        },
        "statement_version": {
          "minLength": 1,
          "title": "Statement Version",
          "type": "string"
        },
        "texts": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/ReportLanguage"
          },
          "title": "Texts",
          "type": "object"
        }
      },
      "required": [
        "statement_id",
        "statement_version",
        "texts",
        "allowed_claim_types",
        "approved"
      ],
      "title": "RegisteredStatement",
      "type": "object"
    },
    "ReportLanguage": {
      "enum": [
        "zh",
        "en",
        "mixed"
      ],
      "title": "ReportLanguage",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/statement-registry/v0.1",
  "additionalProperties": false,
  "properties": {
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "registry_id": {
      "const": "BRIDGE-STATEMENT-REGISTRY-v0.1",
      "title": "Registry Id",
      "type": "string"
    },
    "registry_version": {
      "const": "0.1.0",
      "title": "Registry Version",
      "type": "string"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/RegisteredStatement"
      },
      "title": "Statements",
      "type": "array"
    }
  },
  "required": [
    "object_version",
    "registry_id",
    "registry_version",
    "statements"
  ],
  "title": "StatementRegistry",
  "type": "object"
}
