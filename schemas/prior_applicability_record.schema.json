{
  "$defs": {
    "ContextMatchState": {
      "enum": [
        "match",
        "partial_match",
        "mismatch",
        "not_required",
        "not_assessed"
      ],
      "title": "ContextMatchState",
      "type": "string"
    },
    "PriorKind": {
      "enum": [
        "reference",
        "prior",
        "ontology",
        "knowledge_snapshot"
      ],
      "title": "PriorKind",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/prior-applicability-record/v0.1",
  "additionalProperties": false,
  "properties": {
    "anatomy_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "assay_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "crosswalk_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crosswalk Ref"
    },
    "developmental_stage_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "evidence_family_id": {
      "pattern": "^evidence-family:[A-Za-z0-9._:-]+$",
      "title": "Evidence Family Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "gene_coverage_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "license_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "measurement_spec_ref": {
      "minLength": 1,
      "title": "Measurement Spec Ref",
      "type": "string"
    },
    "object_version": {
      "minLength": 1,
      "title": "Object Version",
      "type": "string"
    },
    "prior_kind": {
      "$ref": "#/$defs/PriorKind"
    },
    "prior_record_id": {
      "pattern": "^prior-record:[A-Za-z0-9._:-]+$",
      "title": "Prior Record Id",
      "type": "string"
    },
    "prior_ref": {
      "minLength": 1,
      "title": "Prior Ref",
      "type": "string"
    },
    "product_definition_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "product_definition_ref": {
      "minLength": 1,
      "title": "Product Definition Ref",
      "type": "string"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Refs",
      "type": "array"
    },
    "required_for_interpretation": {
      "default": true,
      "title": "Required For Interpretation",
      "type": "boolean"
    },
    "snapshot_ref": {
      "minLength": 1,
      "title": "Snapshot Ref",
      "type": "string"
    },
    "species_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "specimen_match": {
      "$ref": "#/$defs/ContextMatchState"
    },
    "version_match": {
      "$ref": "#/$defs/ContextMatchState"
    }
  },
  "required": [
    "prior_record_id",
    "object_version",
    "created_at",
    "measurement_spec_ref",
    "product_definition_ref",
    "prior_ref",
    "snapshot_ref",
    "prior_kind",
    "evidence_family_id",
    "species_match",
    "assay_match",
    "specimen_match",
    "anatomy_match",
    "developmental_stage_match",
    "product_definition_match",
    "gene_coverage_match",
    "version_match",
    "license_match",
    "evidence_refs",
    "provenance_refs"
  ],
  "title": "PriorApplicabilityRecord",
  "type": "object"
}
