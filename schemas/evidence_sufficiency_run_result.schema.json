{
  "$defs": {
    "CaseEvidenceReadinessSummary": {
      "additionalProperties": false,
      "properties": {
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "evidence_sufficiency_counts": {
          "$ref": "#/$defs/StateCount"
        },
        "measurement_evidence_state_counts": {
          "$ref": "#/$defs/MeasurementEvidenceStateCount"
        },
        "product_case_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_count": {
          "maximum": 5,
          "minimum": 1,
          "title": "Profile Count",
          "type": "integer"
        },
        "score_state_counts": {
          "$ref": "#/$defs/ScoreStateCount"
        },
        "summary_id": {
          "pattern": "^case-evidence-readiness-summary:[a-f0-9]{16}$",
          "title": "Summary Id",
          "type": "string"
        },
        "summary_version": {
          "const": "0.1.0",
          "title": "Summary Version",
          "type": "string"
        }
      },
      "required": [
        "summary_id",
        "summary_version",
        "profile_count",
        "evidence_sufficiency_counts",
        "measurement_evidence_state_counts",
        "score_state_counts",
        "blocking_reasons"
      ],
      "title": "CaseEvidenceReadinessSummary",
      "type": "object"
    },
    "DataReadinessState": {
      "enum": [
        "adequate",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "DataReadinessState",
      "type": "string"
    },
    "EvidenceSufficiencyProfile": {
      "additionalProperties": false,
      "properties": {
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_readiness": {
          "$ref": "#/$defs/DataReadinessState"
        },
        "data_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Data Reason Codes",
          "type": "array"
        },
        "deduplicated_evidence_family_ids": {
          "items": {
            "pattern": "^evidence-family:[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "title": "Deduplicated Evidence Family Ids",
          "type": "array"
        },
        "deterministic_run_ref": {
          "pattern": "^run-[a-f0-9]{16}$",
          "title": "Deterministic Run Ref",
          "type": "string"
        },
        "domain_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/P0DomainId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "domain_score": {
          "default": null,
          "title": "Domain Score",
          "type": "null"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_sufficiency_state": {
          "$ref": "#/$defs/EvidenceSufficiencyState"
        },
        "gate_rule_spec_ref": {
          "const": "GATE-EVIDENCE-SUFFICIENCY-v0.1",
          "title": "Gate Rule Spec Ref",
          "type": "string"
        },
        "gate_rule_version": {
          "const": "0.1.0",
          "title": "Gate Rule Version",
          "type": "string"
        },
        "limiting_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Limiting Reasons",
          "type": "array"
        },
        "measurement_evidence_state_counts": {
          "$ref": "#/$defs/MeasurementEvidenceStateCount"
        },
        "measurement_result_refs": {
          "items": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "title": "Measurement Result Refs",
          "type": "array"
        },
        "measurement_spec_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "missing_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Missing Requirements",
          "type": "array"
        },
        "model_robustness": {
          "$ref": "#/$defs/ModelRobustnessState"
        },
        "prior_applicability": {
          "$ref": "#/$defs/PriorApplicabilityState"
        },
        "prior_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Prior Reason Codes",
          "type": "array"
        },
        "product_case_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product_definition_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_id": {
          "pattern": "^evidence-sufficiency-profile:[a-f0-9]{16}:[A-Za-z0-9._:-]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "const": "0.1.0",
          "title": "Profile Version",
          "type": "string"
        },
        "qc_profile_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "robustness_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Robustness Reason Codes",
          "type": "array"
        },
        "score_contract_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Contract Ref"
        },
        "score_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Score Reason Codes",
          "type": "array"
        },
        "score_state": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Score State",
          "type": "string"
        },
        "sensitivity_refs": {
          "items": {
            "type": "string"
          },
          "title": "Sensitivity Refs",
          "type": "array"
        },
        "snapshot_refs": {
          "items": {
            "type": "string"
          },
          "title": "Snapshot Refs",
          "type": "array"
        },
        "validation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Validation Refs",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "gate_rule_spec_ref",
        "gate_rule_version",
        "data_readiness",
        "data_reason_codes",
        "model_robustness",
        "robustness_reason_codes",
        "validation_refs",
        "prior_applicability",
        "prior_reason_codes",
        "snapshot_refs",
        "evidence_sufficiency_state",
        "blocking_reasons",
        "limiting_reasons",
        "missing_requirements",
        "score_reason_codes",
        "measurement_result_refs",
        "measurement_evidence_state_counts",
        "evidence_refs",
        "sensitivity_refs",
        "deduplicated_evidence_family_ids",
        "created_at",
        "deterministic_run_ref"
      ],
      "title": "EvidenceSufficiencyProfile",
      "type": "object"
    },
    "EvidenceSufficiencyState": {
      "enum": [
        "sufficient",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "EvidenceSufficiencyState",
      "type": "string"
    },
    "GateTraceEntry": {
      "additionalProperties": false,
      "properties": {
        "domain_gate_input_ref": {
          "title": "Domain Gate Input Ref",
          "type": "string"
        },
        "evaluated_precedence": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "const": "not_assessed",
              "type": "string"
            },
            {
              "const": "insufficient",
              "type": "string"
            },
            {
              "const": "limited",
              "type": "string"
            },
            {
              "const": "sufficient",
              "type": "string"
            }
          ],
          "title": "Evaluated Precedence",
          "type": "array"
        },
        "ignored_duplicate_input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Ignored Duplicate Input Refs",
          "type": "array"
        },
        "profile_ref": {
          "title": "Profile Ref",
          "type": "string"
        },
        "selected_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Selected Reason Codes",
          "type": "array"
        },
        "selected_state": {
          "$ref": "#/$defs/EvidenceSufficiencyState"
        }
      },
      "required": [
        "profile_ref",
        "domain_gate_input_ref",
        "evaluated_precedence",
        "selected_state",
        "selected_reason_codes",
        "ignored_duplicate_input_refs"
      ],
      "title": "GateTraceEntry",
      "type": "object"
    },
    "MeasurementEvidenceStateCount": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "minimum": 0,
          "title": "Alert",
          "type": "integer"
        },
        "inferred": {
          "minimum": 0,
          "title": "Inferred",
          "type": "integer"
        },
        "measured": {
          "minimum": 0,
          "title": "Measured",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "negative": {
          "minimum": 0,
          "title": "Negative",
          "type": "integer"
        },
        "prior_only": {
          "minimum": 0,
          "title": "Prior Only",
          "type": "integer"
        },
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "MeasurementEvidenceStateCount",
      "type": "object"
    },
    "ModelRobustnessState": {
      "enum": [
        "validated_applicable",
        "candidate_applicable",
        "unstable",
        "not_applicable",
        "not_required",
        "not_assessed"
      ],
      "title": "ModelRobustnessState",
      "type": "string"
    },
    "P0DomainId": {
      "enum": [
        "target_identity",
        "regional_fidelity",
        "developmental_compatibility",
        "off_target_control",
        "proliferation_stress_response"
      ],
      "title": "P0DomainId",
      "type": "string"
    },
    "PriorApplicabilityState": {
      "enum": [
        "applicable",
        "partially_applicable",
        "inapplicable",
        "not_required",
        "not_assessed"
      ],
      "title": "PriorApplicabilityState",
      "type": "string"
    },
    "ScoreStateCount": {
      "additionalProperties": false,
      "properties": {
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        }
      },
      "required": [
        "unavailable"
      ],
      "title": "ScoreStateCount",
      "type": "object"
    },
    "StateCount": {
      "additionalProperties": false,
      "properties": {
        "insufficient": {
          "minimum": 0,
          "title": "Insufficient",
          "type": "integer"
        },
        "limited": {
          "minimum": 0,
          "title": "Limited",
          "type": "integer"
        },
        "not_assessed": {
          "minimum": 0,
          "title": "Not Assessed",
          "type": "integer"
        },
        "sufficient": {
          "minimum": 0,
          "title": "Sufficient",
          "type": "integer"
        }
      },
      "required": [
        "sufficient",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "StateCount",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/evidence-sufficiency-run-result/v0.1",
  "additionalProperties": false,
  "properties": {
    "case_summary": {
      "$ref": "#/$defs/CaseEvidenceReadinessSummary"
    },
    "gate_rule_spec_ref": {
      "const": "GATE-EVIDENCE-SUFFICIENCY-v0.1",
      "title": "Gate Rule Spec Ref",
      "type": "string"
    },
    "gate_trace": {
      "items": {
        "$ref": "#/$defs/GateTraceEntry"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Gate Trace",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/EvidenceSufficiencyProfile"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Profiles",
      "type": "array"
    },
    "result_id": {
      "pattern": "^evidence-sufficiency-result:[a-f0-9]{16}$",
      "title": "Result Id",
      "type": "string"
    },
    "result_version": {
      "const": "0.1.0",
      "title": "Result Version",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "result_version",
    "gate_rule_spec_ref",
    "profiles",
    "case_summary",
    "gate_trace"
  ],
  "title": "EvidenceSufficiencyRunResult",
  "type": "object"
}
