{
  "$defs": {
    "MeasurementEvidenceStateCount": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "minimum": 0,
          "title": "Alert",
          "type": "integer"
        },
        "inferred": {
          "minimum": 0,
          "title": "Inferred",
          "type": "integer"
        },
        "measured": {
          "minimum": 0,
          "title": "Measured",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "negative": {
          "minimum": 0,
          "title": "Negative",
          "type": "integer"
        },
        "prior_only": {
          "minimum": 0,
          "title": "Prior Only",
          "type": "integer"
        },
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "MeasurementEvidenceStateCount",
      "type": "object"
    },
    "ScoreStateCount": {
      "additionalProperties": false,
      "properties": {
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        }
      },
      "required": [
        "unavailable"
      ],
      "title": "ScoreStateCount",
      "type": "object"
    },
    "StateCount": {
      "additionalProperties": false,
      "properties": {
        "insufficient": {
          "minimum": 0,
          "title": "Insufficient",
          "type": "integer"
        },
        "limited": {
          "minimum": 0,
          "title": "Limited",
          "type": "integer"
        },
        "not_assessed": {
          "minimum": 0,
          "title": "Not Assessed",
          "type": "integer"
        },
        "sufficient": {
          "minimum": 0,
          "title": "Sufficient",
          "type": "integer"
        }
      },
      "required": [
        "sufficient",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "StateCount",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/case-evidence-readiness-summary/v0.1",
  "additionalProperties": false,
  "properties": {
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "evidence_sufficiency_counts": {
      "$ref": "#/$defs/StateCount"
    },
    "measurement_evidence_state_counts": {
      "$ref": "#/$defs/MeasurementEvidenceStateCount"
    },
    "product_case_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_count": {
      "maximum": 5,
      "minimum": 1,
      "title": "Profile Count",
      "type": "integer"
    },
    "score_state_counts": {
      "$ref": "#/$defs/ScoreStateCount"
    },
    "summary_id": {
      "pattern": "^case-evidence-readiness-summary:[a-f0-9]{16}$",
      "title": "Summary Id",
      "type": "string"
    },
    "summary_version": {
      "const": "0.1.0",
      "title": "Summary Version",
      "type": "string"
    }
  },
  "required": [
    "summary_id",
    "summary_version",
    "profile_count",
    "evidence_sufficiency_counts",
    "measurement_evidence_state_counts",
    "score_state_counts",
    "blocking_reasons"
  ],
  "title": "CaseEvidenceReadinessSummary",
  "type": "object"
}
