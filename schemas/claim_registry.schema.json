{
  "$defs": {
    "ClaimRequirementSpec": {
      "additionalProperties": false,
      "properties": {
        "blocking_scope": {
          "minLength": 1,
          "title": "Blocking Scope",
          "type": "string"
        },
        "channel_role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Channel Role",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "required_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Experiment"
        },
        "required_modality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Modality"
        },
        "requirement_key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Requirement Key",
          "type": "string"
        }
      },
      "required": [
        "requirement_key",
        "channel_role",
        "blocking_scope"
      ],
      "title": "ClaimRequirementSpec",
      "type": "object"
    },
    "ClaimSpec": {
      "additionalProperties": false,
      "properties": {
        "allowed_relations": {
          "items": {
            "$ref": "#/$defs/EvidenceRelation"
          },
          "minItems": 1,
          "title": "Allowed Relations",
          "type": "array"
        },
        "biological_context_ref": {
          "minLength": 1,
          "title": "Biological Context Ref",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^claim:[A-Za-z0-9._:-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_target_ref": {
          "minLength": 1,
          "title": "Claim Target Ref",
          "type": "string"
        },
        "claim_type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Claim Type",
          "type": "string"
        },
        "domain_id": {
          "$ref": "#/$defs/P0DomainId"
        },
        "reconciliation_spec_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "requirement_specs": {
          "items": {
            "$ref": "#/$defs/ClaimRequirementSpec"
          },
          "title": "Requirement Specs",
          "type": "array"
        },
        "reviewer_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Ref"
        },
        "status": {
          "$ref": "#/$defs/RegistryStatus"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "version",
        "claim_type",
        "domain_id",
        "claim_target_ref",
        "biological_context_ref",
        "allowed_relations",
        "reconciliation_spec_ref",
        "status"
      ],
      "title": "ClaimSpec",
      "type": "object"
    },
    "EvidenceRelation": {
      "enum": [
        "supports",
        "contradicts"
      ],
      "title": "EvidenceRelation",
      "type": "string"
    },
    "P0DomainId": {
      "enum": [
        "target_identity",
        "regional_fidelity",
        "developmental_compatibility",
        "off_target_control",
        "proliferation_stress_response"
      ],
      "title": "P0DomainId",
      "type": "string"
    },
    "RegistryStatus": {
      "enum": [
        "candidate",
        "frozen",
        "retired"
      ],
      "title": "RegistryStatus",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/claim-registry/v0.1",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimSpec"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "registry_id": {
      "const": "BRIDGE-CLAIM-REGISTRY-v0.1",
      "title": "Registry Id",
      "type": "string"
    },
    "registry_version": {
      "const": "0.1.0",
      "title": "Registry Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RegistryStatus"
    }
  },
  "required": [
    "registry_id",
    "registry_version",
    "status",
    "created_at",
    "claims"
  ],
  "title": "ClaimRegistry",
  "type": "object"
}
