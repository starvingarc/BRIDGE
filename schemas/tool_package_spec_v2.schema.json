{
  "$defs": {
    "ImplementationState": {
      "enum": [
        "scaffold",
        "implemented",
        "deprecated"
      ],
      "title": "ImplementationState",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/tool-package-spec/v0.2",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "implementation_state": {
            "const": "implemented"
          }
        },
        "required": [
          "implementation_state"
        ]
      },
      "then": {
        "properties": {
          "adapter_ref": {
            "minLength": 1,
            "type": "string"
          },
          "method_ids": {
            "minItems": 1
          },
          "result_schema_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "adapter_ref",
          "result_schema_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "implementation_state": {
            "const": "scaffold"
          }
        },
        "required": [
          "implementation_state"
        ]
      },
      "then": {
        "properties": {
          "adapter_ref": {
            "type": "null"
          },
          "result_schema_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "adapter_ref": {
      "anyOf": [
        {
          "pattern": "^bridge\\.tool_packages(?:\\.[A-Za-z_][A-Za-z0-9_]*)+:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Ref"
    },
    "card_ref": {
      "title": "Card Ref",
      "type": "string"
    },
    "environment_spec_id": {
      "title": "Environment Spec Id",
      "type": "string"
    },
    "implementation_state": {
      "$ref": "#/$defs/ImplementationState"
    },
    "input_schema_ref": {
      "const": "bridge://schemas/tool-request/v0.2",
      "title": "Input Schema Ref",
      "type": "string"
    },
    "method_ids": {
      "items": {
        "type": "string"
      },
      "title": "Method Ids",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "optional": {
      "default": false,
      "title": "Optional",
      "type": "boolean"
    },
    "output_schema_ref": {
      "const": "bridge://schemas/tool-run/v0.2",
      "title": "Output Schema Ref",
      "type": "string"
    },
    "result_schema_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Schema Ref"
    },
    "scientific_status": {
      "title": "Scientific Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^P0-(0[1-9]|1[0-2])$",
      "title": "Tool Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "tool_id",
    "name",
    "version",
    "summary",
    "implementation_state",
    "scientific_status",
    "environment_spec_id",
    "input_schema_ref",
    "output_schema_ref",
    "method_ids",
    "card_ref"
  ],
  "title": "ToolPackageSpecV2",
  "type": "object"
}
