{
  "$defs": {
    "VerifiedClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "claim_ref": {
          "title": "Claim Ref",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "product_case_ref": {
          "title": "Product Case Ref",
          "type": "string"
        },
        "statement_refs": {
          "items": {
            "type": "string"
          },
          "title": "Statement Refs",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_ref",
        "product_case_ref",
        "text",
        "evidence_refs",
        "statement_refs"
      ],
      "title": "VerifiedClaim",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/verified-report/v0.1",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/VerifiedClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "verification_id": {
      "title": "Verification Id",
      "type": "string"
    },
    "verified_report_id": {
      "pattern": "^verified-report:[a-f0-9]{16}$",
      "title": "Verified Report Id",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "verified_report_id",
    "verification_id",
    "claims"
  ],
  "title": "VerifiedReport",
  "type": "object"
}
