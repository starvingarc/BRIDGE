{
  "$defs": {
    "DataReadinessState": {
      "enum": [
        "adequate",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "DataReadinessState",
      "type": "string"
    },
    "EvidenceSufficiencyState": {
      "enum": [
        "sufficient",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "EvidenceSufficiencyState",
      "type": "string"
    },
    "ModelRobustnessState": {
      "enum": [
        "validated_applicable",
        "candidate_applicable",
        "unstable",
        "not_applicable",
        "not_required",
        "not_assessed"
      ],
      "title": "ModelRobustnessState",
      "type": "string"
    },
    "P0DomainId": {
      "enum": [
        "target_identity",
        "regional_fidelity",
        "developmental_compatibility",
        "off_target_control",
        "proliferation_stress_response"
      ],
      "title": "P0DomainId",
      "type": "string"
    },
    "PriorApplicabilityState": {
      "enum": [
        "applicable",
        "partially_applicable",
        "inapplicable",
        "not_required",
        "not_assessed"
      ],
      "title": "PriorApplicabilityState",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/evidence-sufficiency-profile/v0.1",
  "additionalProperties": false,
  "properties": {
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_readiness": {
      "$ref": "#/$defs/DataReadinessState"
    },
    "data_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Data Reason Codes",
      "type": "array"
    },
    "deduplicated_evidence_family_ids": {
      "items": {
        "type": "string"
      },
      "title": "Deduplicated Evidence Family Ids",
      "type": "array"
    },
    "deterministic_run_ref": {
      "pattern": "^run-[a-f0-9]{16}$",
      "title": "Deterministic Run Ref",
      "type": "string"
    },
    "domain_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/P0DomainId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "evidence_sufficiency_state": {
      "$ref": "#/$defs/EvidenceSufficiencyState"
    },
    "gate_rule_spec_ref": {
      "const": "GATE-EVIDENCE-SUFFICIENCY-v0.1",
      "title": "Gate Rule Spec Ref",
      "type": "string"
    },
    "gate_rule_version": {
      "const": "0.1.0",
      "title": "Gate Rule Version",
      "type": "string"
    },
    "limiting_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Limiting Reasons",
      "type": "array"
    },
    "measurement_result_refs": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Result Refs",
      "type": "array"
    },
    "measurement_spec_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Spec Ref"
    },
    "missing_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Missing Requirements",
      "type": "array"
    },
    "model_robustness": {
      "$ref": "#/$defs/ModelRobustnessState"
    },
    "prior_applicability": {
      "$ref": "#/$defs/PriorApplicabilityState"
    },
    "prior_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Prior Reason Codes",
      "type": "array"
    },
    "product_case_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Case Ref"
    },
    "product_definition_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Definition Ref"
    },
    "profile_id": {
      "pattern": "^evidence-sufficiency-profile:[a-f0-9]{16}:[A-Za-z0-9._:-]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "const": "0.1.0",
      "title": "Profile Version",
      "type": "string"
    },
    "qc_profile_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qc Profile Ref"
    },
    "robustness_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Robustness Reason Codes",
      "type": "array"
    },
    "score_contract_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score Contract Ref"
    },
    "score_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Score Reason Codes",
      "type": "array"
    },
    "score_state": {
      "const": "unavailable",
      "default": "unavailable",
      "title": "Score State",
      "type": "string"
    },
    "sensitivity_refs": {
      "items": {
        "type": "string"
      },
      "title": "Sensitivity Refs",
      "type": "array"
    },
    "snapshot_refs": {
      "items": {
        "type": "string"
      },
      "title": "Snapshot Refs",
      "type": "array"
    },
    "validation_refs": {
      "items": {
        "type": "string"
      },
      "title": "Validation Refs",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "gate_rule_spec_ref",
    "gate_rule_version",
    "data_readiness",
    "data_reason_codes",
    "model_robustness",
    "robustness_reason_codes",
    "validation_refs",
    "prior_applicability",
    "prior_reason_codes",
    "snapshot_refs",
    "evidence_sufficiency_state",
    "blocking_reasons",
    "limiting_reasons",
    "missing_requirements",
    "score_reason_codes",
    "measurement_result_refs",
    "evidence_refs",
    "sensitivity_refs",
    "deduplicated_evidence_family_ids",
    "created_at",
    "deterministic_run_ref"
  ],
  "title": "EvidenceSufficiencyProfile",
  "type": "object"
}
