{
  "$defs": {
    "AnalysisScope": {
      "enum": [
        "whole_product",
        "state_specific"
      ],
      "title": "AnalysisScope",
      "type": "string"
    },
    "DeferredAssessmentProfile": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "const": "not_assessed",
          "title": "Assessment State",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "assessment_state",
        "reason_code"
      ],
      "title": "DeferredAssessmentProfile",
      "type": "object"
    },
    "ProgramEvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable"
      ],
      "title": "ProgramEvidenceState",
      "type": "string"
    },
    "ProgramInputChecksums": {
      "additionalProperties": false,
      "properties": {
        "developmental_compatibility_result": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Developmental Compatibility Result",
          "type": "string"
        },
        "product_case": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Case",
          "type": "string"
        },
        "product_definition_card": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Definition Card",
          "type": "string"
        },
        "program_assessment_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Program Assessment Spec",
          "type": "string"
        },
        "program_evidence_bundle": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Program Evidence Bundle",
          "type": "string"
        },
        "qc_readiness_profile": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qc Readiness Profile",
          "type": "string"
        }
      },
      "required": [
        "product_case",
        "product_definition_card",
        "program_assessment_spec",
        "program_evidence_bundle",
        "developmental_compatibility_result",
        "qc_readiness_profile"
      ],
      "title": "ProgramInputChecksums",
      "type": "object"
    },
    "ProgramObservationAssessment": {
      "additionalProperties": false,
      "properties": {
        "analysis_scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "analysis_unit_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "evidence_family_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Evidence Family Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "evidence_state": {
          "$ref": "#/$defs/ProgramEvidenceState"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exclusion Reason"
        },
        "gene_coverage": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene Coverage"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "method_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "metric_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Metric Name",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^program-observation:[A-Za-z0-9._:-]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "reference_relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceRelation"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage_context_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "state_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "observation_id",
        "evidence_family_id",
        "analysis_unit_ref",
        "metric_name",
        "unit",
        "analysis_scope",
        "state_ref",
        "stage_context_ref",
        "method_ref",
        "evidence_state",
        "value",
        "reference_relation",
        "included",
        "exclusion_reason",
        "evidence_refs"
      ],
      "title": "ProgramObservationAssessment",
      "type": "object"
    },
    "ProgramRuleResult": {
      "additionalProperties": false,
      "properties": {
        "analysis_scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "included_biological_unit_count": {
          "minimum": 0,
          "title": "Included Biological Unit Count",
          "type": "integer"
        },
        "metric_name": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Metric Name",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ProgramObservationAssessment"
          },
          "title": "Observations",
          "type": "array"
        },
        "program_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "reference_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Reference Lower"
        },
        "reference_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Reference Upper"
        },
        "review_flag_state": {
          "$ref": "#/$defs/ReviewFlagState"
        },
        "rule_id": {
          "pattern": "^program-review-rule:[A-Za-z0-9._:-]+$",
          "title": "Rule Id",
          "type": "string"
        },
        "stage_context_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "state_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "triggering_biological_unit_count": {
          "minimum": 0,
          "title": "Triggering Biological Unit Count",
          "type": "integer"
        },
        "unit": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "program_ref",
        "analysis_scope",
        "state_ref",
        "stage_context_ref",
        "metric_name",
        "unit",
        "reference_lower",
        "reference_upper",
        "observations",
        "included_biological_unit_count",
        "triggering_biological_unit_count",
        "review_flag_state",
        "evidence_refs",
        "reason_codes"
      ],
      "title": "ProgramRuleResult",
      "type": "object"
    },
    "ReferenceRelation": {
      "enum": [
        "below_reference",
        "within_reference",
        "above_reference"
      ],
      "title": "ReferenceRelation",
      "type": "string"
    },
    "ReviewFlagState": {
      "enum": [
        "transcriptomic_review_flag",
        "cannot_resolve",
        "not_assessed"
      ],
      "title": "ReviewFlagState",
      "type": "string"
    },
    "TranscriptomicReviewFlag": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "flag_status": {
          "const": "shadow",
          "title": "Flag Status",
          "type": "string"
        },
        "orthogonal_follow_up_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Orthogonal Follow Up Refs",
          "type": "array",
          "uniqueItems": true
        },
        "program_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "review_flag_state": {
          "$ref": "#/$defs/ReviewFlagState"
        },
        "rule_id": {
          "pattern": "^program-review-rule:[A-Za-z0-9._:-]+$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "review_flag_state",
        "flag_status",
        "rule_id",
        "program_ref",
        "evidence_refs",
        "orthogonal_follow_up_refs",
        "reason_codes"
      ],
      "title": "TranscriptomicReviewFlag",
      "type": "object"
    },
    "UnmatchedProgramObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^program-observation:[A-Za-z0-9._:-]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "program_rule_not_configured",
            "program_rule_binding_mismatch"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^program-review-rule:[A-Za-z0-9._:-]+$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "rule_id",
        "reason_code"
      ],
      "title": "UnmatchedProgramObservation",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/proliferation-stress-response-profile/v0.1",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "score_state": {
            "const": "shadow"
          }
        }
      },
      "if": {
        "properties": {
          "result_state": {
            "const": "not_assessed"
          }
        },
        "required": [
          "result_state"
        ]
      },
      "then": {
        "properties": {
          "score_state": {
            "const": "unavailable"
          }
        }
      }
    }
  ],
  "properties": {
    "assessment_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "developmental_result_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_bundle_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "input_sha256_by_role": {
      "$ref": "#/$defs/ProgramInputChecksums"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "process_attribution": {
      "$ref": "#/$defs/DeferredAssessmentProfile"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "product_definition_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "profile_id": {
      "pattern": "^proliferation-stress-profile:[a-f0-9]{16}$",
      "title": "Profile Id",
      "type": "string"
    },
    "program_results": {
      "items": {
        "$ref": "#/$defs/ProgramRuleResult"
      },
      "title": "Program Results",
      "type": "array"
    },
    "qc_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array",
      "uniqueItems": true
    },
    "residual_pluripotency_lod": {
      "$ref": "#/$defs/DeferredAssessmentProfile"
    },
    "result_state": {
      "enum": [
        "complete",
        "partial",
        "not_assessed"
      ],
      "title": "Result State",
      "type": "string"
    },
    "review_flags": {
      "items": {
        "$ref": "#/$defs/TranscriptomicReviewFlag"
      },
      "title": "Review Flags",
      "type": "array"
    },
    "score_state": {
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "tool_id": {
      "const": "P0-06",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Version",
      "type": "string"
    },
    "transcriptomic_cnv": {
      "$ref": "#/$defs/DeferredAssessmentProfile"
    },
    "unmatched_observations": {
      "items": {
        "$ref": "#/$defs/UnmatchedProgramObservation"
      },
      "title": "Unmatched Observations",
      "type": "array"
    }
  },
  "required": [
    "object_version",
    "profile_id",
    "tool_id",
    "tool_version",
    "product_case_ref",
    "product_definition_ref",
    "assessment_spec_ref",
    "evidence_bundle_ref",
    "developmental_result_ref",
    "qc_profile_ref",
    "input_sha256_by_role",
    "result_state",
    "program_results",
    "review_flags",
    "unmatched_observations",
    "process_attribution",
    "residual_pluripotency_lod",
    "transcriptomic_cnv",
    "evidence_refs",
    "reason_codes",
    "score_state"
  ],
  "title": "ProliferationStressResponseProfile",
  "type": "object"
}
