{
  "$defs": {
    "CompositionView": {
      "enum": [
        "consensus_supported_only",
        "source_specific"
      ],
      "title": "CompositionView",
      "type": "string"
    },
    "RegionalFidelityChannel": {
      "additionalProperties": false,
      "properties": {
        "composition_view": {
          "$ref": "#/$defs/CompositionView"
        },
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "target_related_denominator": {
          "minimum": 0,
          "title": "Target Related Denominator",
          "type": "integer"
        },
        "target_related_role_fractions": {
          "items": {
            "$ref": "#/$defs/RoleFraction"
          },
          "minItems": 1,
          "title": "Target Related Role Fractions",
          "type": "array"
        },
        "whole_product_denominator": {
          "exclusiveMinimum": 0,
          "title": "Whole Product Denominator",
          "type": "integer"
        },
        "whole_product_target_region_fraction": {
          "$ref": "#/$defs/RoleFraction"
        }
      },
      "required": [
        "composition_view",
        "label_level",
        "whole_product_denominator",
        "target_related_denominator",
        "target_related_role_fractions",
        "whole_product_target_region_fraction"
      ],
      "title": "RegionalFidelityChannel",
      "type": "object"
    },
    "RoleFraction": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "numerator",
        "denominator"
      ],
      "title": "RoleFraction",
      "type": "object"
    },
    "SpatialReferenceProjectionProfile": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "const": "not_assessed",
          "title": "Assessment State",
          "type": "string"
        },
        "reason_code": {
          "const": "spatial_projection_not_supplied",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "assessment_state",
        "reason_code"
      ],
      "title": "SpatialReferenceProjectionProfile",
      "type": "object"
    },
    "TargetIdentityChannel": {
      "additionalProperties": false,
      "properties": {
        "composition_view": {
          "$ref": "#/$defs/CompositionView"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "role_fractions": {
          "items": {
            "$ref": "#/$defs/RoleFraction"
          },
          "minItems": 1,
          "title": "Role Fractions",
          "type": "array"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "composition_view",
        "label_level",
        "denominator",
        "role_fractions"
      ],
      "title": "TargetIdentityChannel",
      "type": "object"
    },
    "UnmappedStateRecord": {
      "additionalProperties": false,
      "properties": {
        "composition_view": {
          "$ref": "#/$defs/CompositionView"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "reason_code": {
          "const": "state_role_not_configured",
          "title": "Reason Code",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "state_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "label_level",
        "composition_view",
        "count",
        "denominator",
        "reason_code"
      ],
      "title": "UnmappedStateRecord",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/target-regional-evidence-result/v0.1",
  "additionalProperties": false,
  "properties": {
    "assessment_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "cell_state_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "input_sha256_by_role": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Sha256 By Role",
      "type": "object"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "product_definition_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "qc_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "regional_fidelity_channels": {
      "items": {
        "$ref": "#/$defs/RegionalFidelityChannel"
      },
      "title": "Regional Fidelity Channels",
      "type": "array"
    },
    "result_id": {
      "pattern": "^target-regional-result:[a-f0-9]{16}$",
      "title": "Result Id",
      "type": "string"
    },
    "result_state": {
      "enum": [
        "complete",
        "partial",
        "not_assessed"
      ],
      "title": "Result State",
      "type": "string"
    },
    "score_state": {
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "spatial_projection": {
      "$ref": "#/$defs/SpatialReferenceProjectionProfile"
    },
    "state_role_map_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "target_identity_channels": {
      "items": {
        "$ref": "#/$defs/TargetIdentityChannel"
      },
      "title": "Target Identity Channels",
      "type": "array"
    },
    "tool_id": {
      "const": "P0-03",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Version",
      "type": "string"
    },
    "unmapped_states": {
      "items": {
        "$ref": "#/$defs/UnmappedStateRecord"
      },
      "title": "Unmapped States",
      "type": "array"
    }
  },
  "required": [
    "object_version",
    "result_id",
    "tool_id",
    "tool_version",
    "product_case_ref",
    "product_definition_ref",
    "state_role_map_ref",
    "assessment_spec_ref",
    "cell_state_profile_ref",
    "qc_profile_ref",
    "input_sha256_by_role",
    "result_state",
    "target_identity_channels",
    "regional_fidelity_channels",
    "unmapped_states",
    "spatial_projection",
    "evidence_refs",
    "reason_codes",
    "score_state"
  ],
  "title": "TargetRegionalEvidenceResult",
  "type": "object"
}
