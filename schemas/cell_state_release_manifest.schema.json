{
  "$defs": {
    "ReviewerSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "reviewer_id": {
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_role": {
          "enum": [
            "bridge_scientific_lead",
            "chen_team_reviewer"
          ],
          "title": "Reviewer Role",
          "type": "string"
        },
        "signature_base64": {
          "maxLength": 96,
          "minLength": 80,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        }
      },
      "required": [
        "reviewer_id",
        "reviewer_role",
        "key_id",
        "signed_at",
        "object_sha256",
        "signature_base64"
      ],
      "title": "ReviewerSignature",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/cell-state-release-manifest/v0.1",
  "additionalProperties": false,
  "properties": {
    "annotation_vocabulary_ref": {
      "title": "Annotation Vocabulary Ref",
      "type": "string"
    },
    "assay": {
      "enum": [
        "scRNA-seq",
        "snRNA-seq"
      ],
      "title": "Assay",
      "type": "string"
    },
    "benchmark_spec_ref": {
      "title": "Benchmark Spec Ref",
      "type": "string"
    },
    "biological_review_ref": {
      "title": "Biological Review Ref",
      "type": "string"
    },
    "biological_review_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Biological Review Sha256"
    },
    "environment_spec_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Spec Ref"
    },
    "freeze_gate_ref": {
      "title": "Freeze Gate Ref",
      "type": "string"
    },
    "freeze_gate_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freeze Gate Sha256"
    },
    "locked_run_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked Run Manifest Sha256"
    },
    "locked_split_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked Split Manifest Sha256"
    },
    "locked_summary_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked Summary Sha256"
    },
    "locked_test_state": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ],
      "title": "Locked Test State",
      "type": "string"
    },
    "measurement_spec_ref": {
      "title": "Measurement Spec Ref",
      "type": "string"
    },
    "method_implementation_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Method Implementation Versions",
      "type": "object"
    },
    "per_state_release": {
      "additionalProperties": {
        "enum": [
          "shadow",
          "provisional_frozen",
          "frozen",
          "unavailable"
        ],
        "type": "string"
      },
      "title": "Per State Release",
      "type": "object"
    },
    "reference_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Manifest Sha256"
    },
    "reference_snapshot_ref": {
      "title": "Reference Snapshot Ref",
      "type": "string"
    },
    "release_manifest_id": {
      "title": "Release Manifest Id",
      "type": "string"
    },
    "runtime_tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Tool Version"
    },
    "selected_methods": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Selected Methods",
      "type": "object"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/ReviewerSignature"
      },
      "title": "Signatures",
      "type": "array"
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "release_manifest_id",
    "version",
    "status",
    "assay",
    "annotation_vocabulary_ref",
    "reference_snapshot_ref",
    "measurement_spec_ref",
    "benchmark_spec_ref",
    "biological_review_ref",
    "freeze_gate_ref",
    "locked_test_state",
    "per_state_release"
  ],
  "title": "CellStateReleaseManifest",
  "type": "object"
}
