{
  "$defs": {
    "ConfiguredIntervalRelation": {
      "enum": [
        "below_configured_interval",
        "within_configured_interval",
        "above_configured_interval",
        "no_interval_configured",
        "unavailable"
      ],
      "title": "ConfiguredIntervalRelation",
      "type": "string"
    },
    "GraftAnalysisMode": {
      "enum": [
        "unavailable",
        "descriptive_only"
      ],
      "title": "GraftAnalysisMode",
      "type": "string"
    },
    "GraftAnimalChannelSummary": {
      "additionalProperties": false,
      "properties": {
        "animal_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "eligible_observation_count": {
          "exclusiveMinimum": 0,
          "title": "Eligible Observation Count",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Mean"
        },
        "pooled_denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pooled Denominator"
        },
        "pooled_numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pooled Numerator"
        }
      },
      "required": [
        "animal_ref",
        "eligible_observation_count",
        "mean",
        "evidence_refs"
      ],
      "title": "GraftAnimalChannelSummary",
      "type": "object"
    },
    "GraftAvailability": {
      "enum": [
        "not_provided",
        "provided"
      ],
      "title": "GraftAvailability",
      "type": "string"
    },
    "GraftChannelSummary": {
      "additionalProperties": false,
      "properties": {
        "animal_estimand": {
          "const": "mean_of_independent_animal_values",
          "title": "Animal Estimand",
          "type": "string"
        },
        "animal_summaries": {
          "items": {
            "$ref": "#/$defs/GraftAnimalChannelSummary"
          },
          "title": "Animal Summaries",
          "type": "array"
        },
        "channel_id": {
          "pattern": "^graft-channel:[A-Za-z0-9._:-]+$",
          "title": "Channel Id",
          "type": "string"
        },
        "configured_interval_relation": {
          "$ref": "#/$defs/ConfiguredIntervalRelation"
        },
        "configured_lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Configured Lower Bound"
        },
        "configured_upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Configured Upper Bound"
        },
        "cross_stratum_aggregation": {
          "const": "forbidden",
          "title": "Cross Stratum Aggregation",
          "type": "string"
        },
        "denominator_semantics": {
          "enum": [
            "not_applicable",
            "observation_denominator",
            "pooled_denominator"
          ],
          "title": "Denominator Semantics",
          "type": "string"
        },
        "eligible_animal_count": {
          "minimum": 0,
          "title": "Eligible Animal Count",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum"
        },
        "minimum_independent_animals": {
          "exclusiveMinimum": 0,
          "title": "Minimum Independent Animals",
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "result_state": {
          "enum": [
            "available",
            "unavailable",
            "not_assessed"
          ],
          "title": "Result State",
          "type": "string"
        },
        "stratum_id": {
          "pattern": "^graft-stratum:[A-Za-z0-9._:-]+$",
          "title": "Stratum Id",
          "type": "string"
        },
        "stratum_members": {
          "items": {
            "$ref": "#/$defs/GraftStratumMember"
          },
          "minItems": 1,
          "title": "Stratum Members",
          "type": "array"
        },
        "unit": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "within_animal_aggregation": {
          "$ref": "#/$defs/WithinAnimalAggregation"
        }
      },
      "required": [
        "channel_id",
        "stratum_id",
        "stratum_members",
        "unit",
        "required",
        "animal_estimand",
        "within_animal_aggregation",
        "denominator_semantics",
        "cross_stratum_aggregation",
        "minimum_independent_animals",
        "eligible_animal_count",
        "animal_summaries",
        "mean",
        "minimum",
        "maximum",
        "configured_lower_bound",
        "configured_upper_bound",
        "configured_interval_relation",
        "result_state",
        "evidence_refs",
        "reason_codes"
      ],
      "title": "GraftChannelSummary",
      "type": "object"
    },
    "GraftInputChecksums": {
      "additionalProperties": false,
      "properties": {
        "biological_unit_manifest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Biological Unit Manifest",
          "type": "string"
        },
        "graft_assessment_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graft Assessment Spec",
          "type": "string"
        },
        "graft_evidence_bundle": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graft Evidence Bundle",
          "type": "string"
        },
        "graft_lineage_manifest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graft Lineage Manifest"
        },
        "graft_measurement_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graft Measurement Spec",
          "type": "string"
        },
        "product_case": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Case",
          "type": "string"
        }
      },
      "required": [
        "product_case",
        "biological_unit_manifest",
        "graft_measurement_spec",
        "graft_assessment_spec",
        "graft_evidence_bundle"
      ],
      "title": "GraftInputChecksums",
      "type": "object"
    },
    "GraftLineageState": {
      "enum": [
        "declared",
        "reviewed",
        "frozen"
      ],
      "title": "GraftLineageState",
      "type": "string"
    },
    "GraftLinkageState": {
      "enum": [
        "not_applicable",
        "not_declared",
        "partially_declared",
        "declared_with_evidence"
      ],
      "title": "GraftLinkageState",
      "type": "string"
    },
    "GraftStratumMember": {
      "additionalProperties": false,
      "properties": {
        "graft_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "timepoint_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "graft_ref",
        "timepoint_ref"
      ],
      "title": "GraftStratumMember",
      "type": "object"
    },
    "PreparationGraftLinkage": {
      "additionalProperties": false,
      "properties": {
        "animal_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "originating_preparation_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "unit_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "unit_ref",
        "animal_ref",
        "originating_preparation_ref",
        "evidence_refs"
      ],
      "title": "PreparationGraftLinkage",
      "type": "object"
    },
    "UnmatchedGraftObservation": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "pattern": "^graft-channel:[A-Za-z0-9._:-]+$",
          "title": "Channel Id",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^graft-observation:[A-Za-z0-9._:-]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "reason_code": {
          "const": "graft_channel_not_configured",
          "title": "Reason Code",
          "type": "string"
        },
        "unit_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "unit_ref",
        "observation_id",
        "channel_id",
        "reason_code"
      ],
      "title": "UnmatchedGraftObservation",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    },
    "WithinAnimalAggregation": {
      "enum": [
        "single_observation",
        "arithmetic_mean",
        "pooled_numerator_denominator"
      ],
      "title": "WithinAnimalAggregation",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/graft-assessment/v0.1",
  "additionalProperties": false,
  "properties": {
    "analysis_mode": {
      "$ref": "#/$defs/GraftAnalysisMode"
    },
    "assessment_id": {
      "pattern": "^graft-assessment:[a-f0-9]{16}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "channel_summaries": {
      "items": {
        "$ref": "#/$defs/GraftChannelSummary"
      },
      "title": "Channel Summaries",
      "type": "array"
    },
    "design_constraint_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "title": "Design Constraint Refs",
      "type": "array"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_bundle_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "graft_availability": {
      "$ref": "#/$defs/GraftAvailability"
    },
    "graft_case_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "graft_lineage_manifest_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "graft_lineage_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraftLineageState"
        },
        {
          "type": "null"
        }
      ]
    },
    "graft_measurement_spec_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "graft_score": {
      "default": null,
      "title": "Graft Score",
      "type": "null"
    },
    "independent_animal_count": {
      "minimum": 0,
      "title": "Independent Animal Count",
      "type": "integer"
    },
    "input_sha256_by_role": {
      "$ref": "#/$defs/GraftInputChecksums"
    },
    "linkage_state": {
      "$ref": "#/$defs/GraftLinkageState"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "observation_unit_count": {
      "minimum": 0,
      "title": "Observation Unit Count",
      "type": "integer"
    },
    "preparation_linkages": {
      "items": {
        "$ref": "#/$defs/PreparationGraftLinkage"
      },
      "title": "Preparation Linkages",
      "type": "array"
    },
    "product_backfill": {
      "const": "not_performed",
      "title": "Product Backfill",
      "type": "string"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "product_measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array",
      "uniqueItems": true
    },
    "result_state": {
      "enum": [
        "complete",
        "partial",
        "not_assessed",
        "not_provided"
      ],
      "title": "Result State",
      "type": "string"
    },
    "score_state": {
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "tool_id": {
      "const": "P0-12",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Version",
      "type": "string"
    },
    "unmatched_observations": {
      "items": {
        "$ref": "#/$defs/UnmatchedGraftObservation"
      },
      "title": "Unmatched Observations",
      "type": "array"
    }
  },
  "required": [
    "object_version",
    "assessment_id",
    "tool_id",
    "tool_version",
    "assessment_spec_ref",
    "evidence_bundle_ref",
    "product_case_ref",
    "graft_case_ref",
    "product_measurement_spec_ref",
    "graft_measurement_spec_ref",
    "graft_lineage_manifest_ref",
    "graft_lineage_state",
    "input_sha256_by_role",
    "result_state",
    "graft_availability",
    "linkage_state",
    "analysis_mode",
    "observation_unit_count",
    "independent_animal_count",
    "design_constraint_refs",
    "channel_summaries",
    "preparation_linkages",
    "unmatched_observations",
    "evidence_refs",
    "reason_codes",
    "product_backfill",
    "score_state"
  ],
  "title": "GraftAssessment",
  "type": "object"
}
