{
  "$defs": {
    "DataViewBinding": {
      "additionalProperties": false,
      "description": "Content-addressed expression view passed between scientific tools.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "biological_unit_manifest_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Ref"
        },
        "biological_unit_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Sha256"
        },
        "matrix_location": {
          "minLength": 1,
          "title": "Matrix Location",
          "type": "string"
        },
        "matrix_semantics": {
          "enum": [
            "raw_counts",
            "normalized_expression"
          ],
          "title": "Matrix Semantics",
          "type": "string"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observation_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Ids Sha256",
          "type": "string"
        },
        "parent_asset_id": {
          "minLength": 1,
          "title": "Parent Asset Id",
          "type": "string"
        },
        "parent_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Asset Sha256",
          "type": "string"
        },
        "sample_or_preparation_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Or Preparation Ref"
        },
        "selection_spec_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Spec Ref"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "view_id": {
          "minLength": 1,
          "title": "View Id",
          "type": "string"
        },
        "view_kind": {
          "enum": [
            "all_observations",
            "qc_selected_observations"
          ],
          "title": "View Kind",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "view_kind",
        "artifact_id",
        "sha256",
        "parent_asset_id",
        "parent_asset_sha256",
        "matrix_location",
        "matrix_semantics",
        "n_observations",
        "observation_ids_sha256"
      ],
      "title": "DataViewBinding",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/cell-state-evidence-profile/v0.1",
  "additionalProperties": false,
  "properties": {
    "annotation_vocabulary_ref": {
      "title": "Annotation Vocabulary Ref",
      "type": "string"
    },
    "assay": {
      "title": "Assay",
      "type": "string"
    },
    "assignment_state": {
      "additionalProperties": true,
      "title": "Assignment State",
      "type": "object"
    },
    "calibration": {
      "additionalProperties": true,
      "title": "Calibration",
      "type": "object"
    },
    "composition": {
      "additionalProperties": true,
      "title": "Composition",
      "type": "object"
    },
    "denominator": {
      "title": "Denominator",
      "type": "string"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "gene_coverage": {
      "additionalProperties": true,
      "title": "Gene Coverage",
      "type": "object"
    },
    "input_data_view": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataViewBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "label_levels": {
      "additionalProperties": true,
      "title": "Label Levels",
      "type": "object"
    },
    "marker_program_evidence": {
      "additionalProperties": true,
      "title": "Marker Program Evidence",
      "type": "object"
    },
    "measurement_spec_id": {
      "title": "Measurement Spec Id",
      "type": "string"
    },
    "measurement_spec_status": {
      "title": "Measurement Spec Status",
      "type": "string"
    },
    "measurement_spec_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Spec Version"
    },
    "method_disagreement": {
      "additionalProperties": true,
      "title": "Method Disagreement",
      "type": "object"
    },
    "method_outputs": {
      "additionalProperties": true,
      "title": "Method Outputs",
      "type": "object"
    },
    "modality_sensitivity": {
      "additionalProperties": true,
      "title": "Modality Sensitivity",
      "type": "object"
    },
    "n_genes": {
      "title": "N Genes",
      "type": "integer"
    },
    "n_observations": {
      "title": "N Observations",
      "type": "integer"
    },
    "per_state_release": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Per State Release",
      "type": "object"
    },
    "prediction_sets": {
      "additionalProperties": true,
      "title": "Prediction Sets",
      "type": "object"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "reference_snapshot_ref": {
      "title": "Reference Snapshot Ref",
      "type": "string"
    },
    "score_state": {
      "default": "shadow",
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "source_support": {
      "additionalProperties": true,
      "title": "Source Support",
      "type": "object"
    },
    "unknown_reason": {
      "additionalProperties": true,
      "title": "Unknown Reason",
      "type": "object"
    },
    "unresolved_labels": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Labels",
      "type": "array"
    },
    "upstream_qc_profile_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Qc Profile Ref"
    },
    "upstream_qc_profile_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Qc Profile Sha256"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "assay",
    "measurement_spec_id",
    "measurement_spec_status",
    "annotation_vocabulary_ref",
    "reference_snapshot_ref",
    "n_observations",
    "n_genes",
    "denominator",
    "label_levels",
    "source_support",
    "marker_program_evidence",
    "prediction_sets",
    "composition",
    "gene_coverage",
    "modality_sensitivity"
  ],
  "title": "CellStateEvidenceProfile",
  "type": "object"
}
