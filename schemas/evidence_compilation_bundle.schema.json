{
  "$defs": {
    "BaseGraphRef": {
      "additionalProperties": false,
      "properties": {
        "graph_id": {
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "graph_version": {
          "minimum": 1,
          "title": "Graph Version",
          "type": "integer"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "graph_id",
        "graph_version",
        "manifest_sha256"
      ],
      "title": "BaseGraphRef",
      "type": "object"
    },
    "BiologicalContext": {
      "additionalProperties": false,
      "properties": {
        "anatomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anatomy"
        },
        "assay": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assay"
        },
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "context_version": {
          "minLength": 1,
          "title": "Context Version",
          "type": "string"
        },
        "developmental_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Developmental Stage"
        },
        "product_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Stage"
        },
        "sampling_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Context"
        },
        "species": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Species"
        },
        "specimen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specimen"
        }
      },
      "required": [
        "context_id",
        "context_version"
      ],
      "title": "BiologicalContext",
      "type": "object"
    },
    "CaseGraphRef": {
      "additionalProperties": false,
      "properties": {
        "graph_id": {
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "graph_version": {
          "minimum": 1,
          "title": "Graph Version",
          "type": "integer"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "product_case_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "graph_id",
        "graph_version",
        "manifest_sha256",
        "product_case_ref"
      ],
      "title": "CaseGraphRef",
      "type": "object"
    },
    "CompilationObjectRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/GraphNodeType"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "node_type",
        "schema_ref",
        "content_hash"
      ],
      "title": "CompilationObjectRef",
      "type": "object"
    },
    "EvidenceApplicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "not_assessed"
      ],
      "title": "EvidenceApplicability",
      "type": "string"
    },
    "EvidenceInterval": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "method_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Ref"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "EvidenceInterval",
      "type": "object"
    },
    "EvidenceLifecycleState": {
      "enum": [
        "active",
        "superseded",
        "invalidated"
      ],
      "title": "EvidenceLifecycleState",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/EvidenceApplicability"
        },
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "biological_context": {
          "$ref": "#/$defs/BiologicalContext"
        },
        "claim_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "compiler_version": {
          "const": "0.2.0",
          "title": "Compiler Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "domain_id": {
          "$ref": "#/$defs/P0DomainId"
        },
        "evidence_family_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "evidence_id": {
          "pattern": "^evidence:[a-f0-9]{24}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "evidence_tier": {
          "$ref": "#/$defs/EvidenceTier"
        },
        "evidence_version": {
          "minimum": 1,
          "title": "Evidence Version",
          "type": "integer"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lifecycle_state": {
          "$ref": "#/$defs/EvidenceLifecycleState"
        },
        "logical_key": {
          "minLength": 1,
          "title": "Logical Key",
          "type": "string"
        },
        "measurement_result_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "measurement_spec_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "predecessor_ref": {
          "anyOf": [
            {
              "pattern": "^evidence:[a-f0-9]{24}@[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Ref"
        },
        "prior_refs": {
          "items": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "title": "Prior Refs",
          "type": "array"
        },
        "product_case_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "provenance_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Provenance Refs",
          "type": "array"
        },
        "reference_refs": {
          "items": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "title": "Reference Refs",
          "type": "array"
        },
        "relation": {
          "$ref": "#/$defs/EvidenceRelation"
        },
        "revision_action": {
          "$ref": "#/$defs/RevisionAction"
        },
        "sample_or_preparation_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "score_contract_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sufficiency_profile_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "tool_run_execution_state": {
          "enum": [
            "succeeded",
            "partial"
          ],
          "title": "Tool Run Execution State",
          "type": "string"
        },
        "tool_run_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "evidence_id",
        "evidence_version",
        "logical_key",
        "content_hash",
        "product_case_ref",
        "sample_or_preparation_ref",
        "domain_id",
        "measurement_result_ref",
        "measurement_spec_ref",
        "metric_id",
        "value",
        "claim_ref",
        "biological_context",
        "relation",
        "evidence_state",
        "evidence_tier",
        "lifecycle_state",
        "applicability",
        "evidence_family_ref",
        "sufficiency_profile_ref",
        "tool_run_ref",
        "tool_run_execution_state",
        "reference_refs",
        "prior_refs",
        "artifact_refs",
        "provenance_refs",
        "revision_action",
        "created_at",
        "compiler_version"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceRelation": {
      "enum": [
        "supports",
        "contradicts"
      ],
      "title": "EvidenceRelation",
      "type": "string"
    },
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "blocking_scope": {
          "minLength": 1,
          "title": "Blocking Scope",
          "type": "string"
        },
        "channel_role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Channel Role",
          "type": "string"
        },
        "claim_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "product_case_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "required_experiment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Experiment"
        },
        "required_modality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Modality"
        },
        "requirement_id": {
          "pattern": "^requirement:[a-f0-9]{24}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement_key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Requirement Key",
          "type": "string"
        },
        "requirement_version": {
          "minimum": 1,
          "title": "Requirement Version",
          "type": "integer"
        },
        "satisfying_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Satisfying Evidence Refs",
          "type": "array"
        },
        "source_contract_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "state": {
          "$ref": "#/$defs/EvidenceRequirementState"
        },
        "supersedes_requirement_ref": {
          "anyOf": [
            {
              "pattern": "^requirement:[a-f0-9]{24}@[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Requirement Ref"
        }
      },
      "required": [
        "requirement_id",
        "requirement_version",
        "claim_ref",
        "product_case_ref",
        "requirement_key",
        "source_contract_ref",
        "channel_role",
        "blocking_scope",
        "state",
        "reason_codes",
        "created_at",
        "content_hash"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "EvidenceRequirementState": {
      "enum": [
        "open",
        "satisfied",
        "not_applicable"
      ],
      "title": "EvidenceRequirementState",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "formal",
        "shadow",
        "exploratory"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "GraphKind": {
      "enum": [
        "case",
        "comparison"
      ],
      "title": "GraphKind",
      "type": "string"
    },
    "GraphNodeType": {
      "enum": [
        "ProductCase",
        "ProductDefinitionCard",
        "Sample",
        "Preparation",
        "MeasurementSpec",
        "ScoreContract",
        "ToolRun",
        "MeasurementResult",
        "EvidenceRecord",
        "Claim",
        "EvidenceFamily",
        "EvidenceRequirement",
        "EvidenceSufficiencyProfile",
        "ReferenceSnapshot",
        "PriorSnapshot",
        "Artifact",
        "ComparisonRecord",
        "ReconciliationSpec",
        "ReconciliationRecord"
      ],
      "title": "GraphNodeType",
      "type": "string"
    },
    "P0DomainId": {
      "enum": [
        "target_identity",
        "regional_fidelity",
        "developmental_compatibility",
        "off_target_control",
        "proliferation_stress_response"
      ],
      "title": "P0DomainId",
      "type": "string"
    },
    "RevisionAction": {
      "enum": [
        "create",
        "supersede",
        "invalidate"
      ],
      "title": "RevisionAction",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/evidence-compilation-bundle/v0.1",
  "additionalProperties": false,
  "properties": {
    "base_graph_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaseGraphRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bundle_id": {
      "pattern": "^evidence-compilation-bundle:[A-Za-z0-9._:-]+$",
      "title": "Bundle Id",
      "type": "string"
    },
    "bundle_version": {
      "const": "0.1.0",
      "title": "Bundle Version",
      "type": "string"
    },
    "candidate_records": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Candidate Records",
      "type": "array"
    },
    "case_graph_refs": {
      "items": {
        "$ref": "#/$defs/CaseGraphRef"
      },
      "title": "Case Graph Refs",
      "type": "array"
    },
    "comparison_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "external_case_evidence_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "applicability": {
            "$ref": "#/$defs/EvidenceApplicability"
          },
          "comparison_claim_ref": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "evidence_content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Evidence Content Hash",
            "type": "string"
          },
          "evidence_family_ref": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "evidence_ref": {
            "pattern": "^evidence:[a-f0-9]{24}@[1-9][0-9]*$",
            "title": "Evidence Ref",
            "type": "string"
          },
          "evidence_state": {
            "$ref": "#/$defs/EvidenceState"
          },
          "evidence_tier": {
            "$ref": "#/$defs/EvidenceTier"
          },
          "lifecycle_state": {
            "$ref": "#/$defs/EvidenceLifecycleState"
          },
          "product_case_ref": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "relation": {
            "$ref": "#/$defs/EvidenceRelation"
          },
          "source_case_graph_ref": {
            "$ref": "#/$defs/CaseGraphRef"
          },
          "source_claim_ref": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "sufficiency_profile_input_id": {
            "minLength": 1,
            "title": "Sufficiency Profile Input Id",
            "type": "string"
          },
          "tool_run_execution_state": {
            "enum": [
              "succeeded",
              "partial",
              "failed",
              "skipped",
              "not_implemented"
            ],
            "title": "Tool Run Execution State",
            "type": "string"
          }
        },
        "required": [
          "source_case_graph_ref",
          "evidence_ref",
          "evidence_content_hash",
          "product_case_ref",
          "source_claim_ref",
          "comparison_claim_ref",
          "evidence_family_ref",
          "sufficiency_profile_input_id",
          "relation",
          "evidence_state",
          "evidence_tier",
          "lifecycle_state",
          "applicability",
          "tool_run_execution_state"
        ],
        "title": "ExternalCaseEvidenceRef",
        "type": "object"
      },
      "title": "External Case Evidence Refs",
      "type": "array"
    },
    "graph_kind": {
      "$ref": "#/$defs/GraphKind"
    },
    "missing_observations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Missing Observations",
      "type": "array"
    },
    "object_catalog": {
      "items": {
        "$ref": "#/$defs/CompilationObjectRef"
      },
      "minItems": 1,
      "title": "Object Catalog",
      "type": "array"
    },
    "prior_evidence_records": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Prior Evidence Records",
      "type": "array"
    },
    "prior_requirements": {
      "items": {
        "$ref": "#/$defs/EvidenceRequirement"
      },
      "title": "Prior Requirements",
      "type": "array"
    },
    "product_case_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Refs",
      "type": "array"
    }
  },
  "required": [
    "bundle_id",
    "bundle_version",
    "graph_kind",
    "object_catalog",
    "created_at",
    "provenance_refs"
  ],
  "title": "EvidenceCompilationBundle",
  "type": "object"
}
