{
  "$defs": {
    "FreezeGateCriterion": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            ">=",
            "<="
          ],
          "title": "Operator",
          "type": "string"
        },
        "pilot_observation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pilot Observation"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "metric",
        "scope",
        "operator",
        "rationale"
      ],
      "title": "FreezeGateCriterion",
      "type": "object"
    },
    "ReviewerSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "reviewer_id": {
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_role": {
          "enum": [
            "bridge_scientific_lead",
            "chen_team_reviewer"
          ],
          "title": "Reviewer Role",
          "type": "string"
        },
        "signature_base64": {
          "maxLength": 96,
          "minLength": 80,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        }
      },
      "required": [
        "reviewer_id",
        "reviewer_role",
        "key_id",
        "signed_at",
        "object_sha256",
        "signature_base64"
      ],
      "title": "ReviewerSignature",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/freeze-gate-spec/v0.1",
  "additionalProperties": false,
  "properties": {
    "benchmark_spec_ref": {
      "title": "Benchmark Spec Ref",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/FreezeGateCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "gate_spec_id": {
      "title": "Gate Spec Id",
      "type": "string"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/ReviewerSignature"
      },
      "title": "Signatures",
      "type": "array"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "gate_spec_id",
    "version",
    "status",
    "benchmark_spec_ref",
    "criteria"
  ],
  "title": "FreezeGateSpec",
  "type": "object"
}
