{
  "$defs": {
    "GraftLineageBinding": {
      "additionalProperties": false,
      "properties": {
        "animal_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "graft_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "lineage_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Lineage Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "originating_preparation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timepoint_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "unit_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "unit_ref",
        "animal_ref",
        "graft_ref",
        "timepoint_ref"
      ],
      "title": "GraftLineageBinding",
      "type": "object"
    },
    "GraftLineageState": {
      "enum": [
        "declared",
        "reviewed",
        "frozen"
      ],
      "title": "GraftLineageState",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/graft-lineage-manifest/v0.1",
  "additionalProperties": false,
  "properties": {
    "generator_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]+$",
      "title": "Generator Id",
      "type": "string"
    },
    "generator_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Generator Version",
      "type": "string"
    },
    "graft_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "lineage_state": {
      "$ref": "#/$defs/GraftLineageState"
    },
    "manifest_id": {
      "pattern": "^graft-lineage-manifest:[A-Za-z0-9._:-]+$",
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Manifest Version",
      "type": "string"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "review_gate_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Gate Ref"
    },
    "review_gate_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Gate Sha256"
    },
    "unit_bindings": {
      "items": {
        "$ref": "#/$defs/GraftLineageBinding"
      },
      "title": "Unit Bindings",
      "type": "array"
    }
  },
  "required": [
    "object_version",
    "manifest_id",
    "manifest_version",
    "generator_id",
    "generator_version",
    "product_case_ref",
    "graft_case_ref",
    "lineage_state"
  ],
  "title": "GraftLineageManifest",
  "type": "object"
}
