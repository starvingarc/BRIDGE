{
  "$defs": {
    "DataViewBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "biological_unit_manifest_ref": {
                  "type": "null"
                },
                "biological_unit_manifest_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "biological_unit_manifest_ref": {
                  "not": {
                    "type": "null"
                  }
                },
                "biological_unit_manifest_sha256": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "biological_unit_manifest_ref",
                "biological_unit_manifest_sha256"
              ]
            }
          ]
        }
      ],
      "description": "Content-addressed expression view passed between scientific tools.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "biological_unit_manifest_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Ref"
        },
        "biological_unit_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Sha256"
        },
        "matrix_location": {
          "minLength": 1,
          "title": "Matrix Location",
          "type": "string"
        },
        "matrix_semantics": {
          "enum": [
            "raw_counts",
            "normalized_expression"
          ],
          "title": "Matrix Semantics",
          "type": "string"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observation_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Ids Sha256",
          "type": "string"
        },
        "parent_asset_id": {
          "minLength": 1,
          "title": "Parent Asset Id",
          "type": "string"
        },
        "parent_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Asset Sha256",
          "type": "string"
        },
        "sample_or_preparation_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Or Preparation Ref"
        },
        "selection_spec_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Spec Ref"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "view_id": {
          "minLength": 1,
          "title": "View Id",
          "type": "string"
        },
        "view_kind": {
          "enum": [
            "all_observations",
            "qc_selected_observations"
          ],
          "title": "View Kind",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "view_kind",
        "artifact_id",
        "sha256",
        "parent_asset_id",
        "parent_asset_sha256",
        "matrix_location",
        "matrix_semantics",
        "n_observations",
        "observation_ids_sha256"
      ],
      "title": "DataViewBinding",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/cell-state-candidate-profile/v1.0",
  "additionalProperties": false,
  "properties": {
    "auxiliary_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Auxiliary Reason Codes",
      "type": "array"
    },
    "auxiliary_run_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Auxiliary Run Ref"
    },
    "auxiliary_state": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Auxiliary State",
      "type": "string"
    },
    "biological_unit_state": {
      "const": "not_estimable",
      "default": "not_estimable",
      "title": "Biological Unit State",
      "type": "string"
    },
    "calibration": {
      "additionalProperties": true,
      "title": "Calibration",
      "type": "object"
    },
    "candidate_composition": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Candidate Composition",
      "type": "array"
    },
    "development_gate_state": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Development Gate State",
      "type": "string"
    },
    "development_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Development Reason Codes",
      "type": "array"
    },
    "development_review_sha256": {
      "title": "Development Review Sha256",
      "type": "string"
    },
    "development_review_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Development Review Version",
      "type": "string"
    },
    "development_summary_sha256": {
      "title": "Development Summary Sha256",
      "type": "string"
    },
    "developmental_window_match": {
      "default": null,
      "title": "Developmental Window Match",
      "type": "null"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "environment_spec_ref": {
      "title": "Environment Spec Ref",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "feature_coverage": {
      "maximum": 1,
      "minimum": 0,
      "title": "Feature Coverage",
      "type": "number"
    },
    "input_data_view": {
      "$ref": "#/$defs/DataViewBinding"
    },
    "input_sha256": {
      "title": "Input Sha256",
      "type": "string"
    },
    "knn_role": {
      "const": "sensitivity_not_independent_vote",
      "default": "sensitivity_not_independent_vote",
      "title": "Knn Role",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "measurement_spec_ref": {
      "const": "CELLSTATE-scRNA-celltypist-candidate-v0.1",
      "default": "CELLSTATE-scRNA-celltypist-candidate-v0.1",
      "title": "Measurement Spec Ref",
      "type": "string"
    },
    "measurement_spec_sha256": {
      "title": "Measurement Spec Sha256",
      "type": "string"
    },
    "missing_features": {
      "items": {
        "type": "string"
      },
      "title": "Missing Features",
      "type": "array"
    },
    "model_manifest_sha256": {
      "title": "Model Manifest Sha256",
      "type": "string"
    },
    "model_sha256": {
      "title": "Model Sha256",
      "type": "string"
    },
    "n_genes": {
      "exclusiveMinimum": 0,
      "title": "N Genes",
      "type": "integer"
    },
    "n_observations": {
      "exclusiveMinimum": 0,
      "title": "N Observations",
      "type": "integer"
    },
    "object_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Object Version",
      "type": "string"
    },
    "per_state_release": {
      "additionalProperties": {
        "const": "unavailable",
        "type": "string"
      },
      "title": "Per State Release",
      "type": "object"
    },
    "primary_method": {
      "const": "CellTypist",
      "default": "CellTypist",
      "title": "Primary Method",
      "type": "string"
    },
    "primary_ood": {
      "const": "energy",
      "default": "energy",
      "title": "Primary Ood",
      "type": "string"
    },
    "producer_run_ref": {
      "title": "Producer Run Ref",
      "type": "string"
    },
    "producer_tool_id": {
      "const": "P0-02",
      "default": "P0-02",
      "title": "Producer Tool Id",
      "type": "string"
    },
    "producer_tool_version": {
      "title": "Producer Tool Version",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "qualified_state_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "title": "Qualified State Ids",
      "type": "array"
    },
    "runtime_ref": {
      "title": "Runtime Ref",
      "type": "string"
    },
    "scientific_qualification": {
      "const": "not_established",
      "default": "not_established",
      "title": "Scientific Qualification",
      "type": "string"
    },
    "score_state": {
      "const": "unavailable",
      "default": "unavailable",
      "title": "Score State",
      "type": "string"
    },
    "target_fraction": {
      "default": null,
      "title": "Target Fraction",
      "type": "null"
    },
    "upstream_qc_profile_ref": {
      "title": "Upstream Qc Profile Ref",
      "type": "string"
    },
    "upstream_qc_profile_sha256": {
      "title": "Upstream Qc Profile Sha256",
      "type": "string"
    },
    "verification_sha256": {
      "title": "Verification Sha256",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "producer_run_ref",
    "producer_tool_version",
    "environment_spec_ref",
    "measurement_spec_sha256",
    "input_data_view",
    "input_sha256",
    "upstream_qc_profile_ref",
    "upstream_qc_profile_sha256",
    "n_observations",
    "n_genes",
    "runtime_ref",
    "model_manifest_sha256",
    "model_sha256",
    "calibration",
    "verification_sha256",
    "development_summary_sha256",
    "development_review_sha256",
    "development_gate_state",
    "development_reason_codes",
    "per_state_release",
    "candidate_composition",
    "feature_coverage",
    "missing_features",
    "auxiliary_run_ref",
    "auxiliary_state",
    "auxiliary_reason_codes",
    "limitations",
    "evidence_ids"
  ],
  "title": "CellStateCandidateProfile",
  "type": "object"
}
