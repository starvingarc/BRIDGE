{
  "$defs": {
    "ReferenceProfile": {
      "additionalProperties": false,
      "properties": {
        "anatomy": {
          "title": "Anatomy",
          "type": "string"
        },
        "assay": {
          "title": "Assay",
          "type": "string"
        },
        "developmental_time": {
          "title": "Developmental Time",
          "type": "string"
        },
        "evidence_family_id": {
          "title": "Evidence Family Id",
          "type": "string"
        },
        "exclusions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Exclusions",
          "type": "object"
        },
        "feature_selection": {
          "additionalProperties": true,
          "title": "Feature Selection",
          "type": "object"
        },
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "matrix_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matrix File"
        },
        "matrix_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matrix Sha256"
        },
        "metadata_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata File"
        },
        "metadata_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Sha256"
        },
        "n_genes": {
          "default": 0,
          "title": "N Genes",
          "type": "integer"
        },
        "n_observations": {
          "default": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "n_samples": {
          "default": 0,
          "title": "N Samples",
          "type": "integer"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "refinement",
            "context",
            "sensitivity"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_family_id": {
          "title": "Source Family Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "source_id",
        "source_family_id",
        "evidence_family_id",
        "assay",
        "anatomy",
        "developmental_time",
        "label_level",
        "role",
        "status"
      ],
      "title": "ReferenceProfile",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/reference-manifest/v0.1",
  "additionalProperties": false,
  "properties": {
    "marker_program_file": {
      "title": "Marker Program File",
      "type": "string"
    },
    "marker_program_sha256": {
      "title": "Marker Program Sha256",
      "type": "string"
    },
    "measurement_spec_ids": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Spec Ids",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ReferenceProfile"
      },
      "title": "Profiles",
      "type": "array"
    },
    "prohibited_source_families": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Source Families",
      "type": "array"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "frozen"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "vocabulary_file": {
      "title": "Vocabulary File",
      "type": "string"
    },
    "vocabulary_sha256": {
      "title": "Vocabulary Sha256",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "version",
    "status",
    "vocabulary_file",
    "vocabulary_sha256",
    "marker_program_file",
    "marker_program_sha256",
    "measurement_spec_ids",
    "profiles"
  ],
  "title": "ReferenceManifest",
  "type": "object"
}
