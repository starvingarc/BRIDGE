{
  "$defs": {
    "BiologicalContext": {
      "additionalProperties": false,
      "properties": {
        "anatomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anatomy"
        },
        "assay": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assay"
        },
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "context_version": {
          "minLength": 1,
          "title": "Context Version",
          "type": "string"
        },
        "developmental_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Developmental Stage"
        },
        "product_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Stage"
        },
        "sampling_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Context"
        },
        "species": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Species"
        },
        "specimen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specimen"
        }
      },
      "required": [
        "context_id",
        "context_version"
      ],
      "title": "BiologicalContext",
      "type": "object"
    },
    "EvidenceApplicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "not_assessed"
      ],
      "title": "EvidenceApplicability",
      "type": "string"
    },
    "EvidenceInterval": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "method_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Ref"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "EvidenceInterval",
      "type": "object"
    },
    "EvidenceLifecycleState": {
      "enum": [
        "active",
        "superseded",
        "invalidated"
      ],
      "title": "EvidenceLifecycleState",
      "type": "string"
    },
    "EvidenceRelation": {
      "enum": [
        "supports",
        "contradicts"
      ],
      "title": "EvidenceRelation",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "formal",
        "shadow",
        "exploratory"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "P0DomainId": {
      "enum": [
        "target_identity",
        "regional_fidelity",
        "developmental_compatibility",
        "off_target_control",
        "proliferation_stress_response"
      ],
      "title": "P0DomainId",
      "type": "string"
    },
    "RevisionAction": {
      "enum": [
        "create",
        "supersede",
        "invalidate"
      ],
      "title": "RevisionAction",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/evidence-record/v0.1",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "properties": {
          "evidence_state": {
            "const": "missing"
          }
        },
        "required": [
          "evidence_state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "value": {
            "type": "null"
          }
        },
        "required": [
          "value"
        ]
      },
      "then": {
        "properties": {
          "evidence_state": {
            "enum": [
              "unknown",
              "unavailable",
              "alert"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision_action": {
            "const": "create"
          }
        },
        "required": [
          "revision_action"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "active"
          },
          "predecessor_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision_action": {
            "const": "supersede"
          }
        },
        "required": [
          "revision_action"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "active"
          },
          "predecessor_ref": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision_action": {
            "const": "invalidate"
          }
        },
        "required": [
          "revision_action"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "invalidated"
          },
          "predecessor_ref": {
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "applicability": {
      "$ref": "#/$defs/EvidenceApplicability"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "biological_context": {
      "$ref": "#/$defs/BiologicalContext"
    },
    "claim_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "compiler_version": {
      "const": "0.2.0",
      "title": "Compiler Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "denominator": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denominator"
    },
    "domain_id": {
      "$ref": "#/$defs/P0DomainId"
    },
    "evidence_family_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "evidence_id": {
      "pattern": "^evidence:[a-f0-9]{24}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_state": {
      "$ref": "#/$defs/EvidenceState"
    },
    "evidence_tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "evidence_version": {
      "minimum": 1,
      "title": "Evidence Version",
      "type": "integer"
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lifecycle_state": {
      "$ref": "#/$defs/EvidenceLifecycleState"
    },
    "logical_key": {
      "minLength": 1,
      "title": "Logical Key",
      "type": "string"
    },
    "measurement_result_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "metric_id": {
      "minLength": 1,
      "title": "Metric Id",
      "type": "string"
    },
    "numerator": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numerator"
    },
    "predecessor_ref": {
      "anyOf": [
        {
          "pattern": "^evidence:[a-f0-9]{24}@[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Ref"
    },
    "prior_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "title": "Prior Refs",
      "type": "array"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Refs",
      "type": "array"
    },
    "reference_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "title": "Reference Refs",
      "type": "array"
    },
    "relation": {
      "$ref": "#/$defs/EvidenceRelation"
    },
    "revision_action": {
      "$ref": "#/$defs/RevisionAction"
    },
    "sample_or_preparation_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "score_contract_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sufficiency_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "tool_run_execution_state": {
      "enum": [
        "succeeded",
        "partial"
      ],
      "title": "Tool Run Execution State",
      "type": "string"
    },
    "tool_run_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "title": "Value"
    }
  },
  "required": [
    "evidence_id",
    "evidence_version",
    "logical_key",
    "content_hash",
    "product_case_ref",
    "sample_or_preparation_ref",
    "domain_id",
    "measurement_result_ref",
    "measurement_spec_ref",
    "metric_id",
    "value",
    "claim_ref",
    "biological_context",
    "relation",
    "evidence_state",
    "evidence_tier",
    "lifecycle_state",
    "applicability",
    "evidence_family_ref",
    "sufficiency_profile_ref",
    "tool_run_ref",
    "tool_run_execution_state",
    "reference_refs",
    "prior_refs",
    "artifact_refs",
    "provenance_refs",
    "revision_action",
    "created_at",
    "compiler_version"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
