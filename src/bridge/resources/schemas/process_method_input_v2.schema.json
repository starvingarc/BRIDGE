          "format": "path",
          "title": "Artifact Manifest Path",
          "type": "string"
        },
        "artifact_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Manifest Sha256",
          "type": "string"
        },
        "evidence_artifact_id": {
          "minLength": 1,
          "title": "Evidence Artifact Id",
          "type": "string"
        },
        "evidence_path": {
          "format": "path",
          "title": "Evidence Path",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "label_level": {
          "const": "L1",
          "title": "Label Level",
          "type": "string"
        },
        "producer_run_ref": {
          "minLength": 1,
          "title": "Producer Run Ref",
          "type": "string"
        },
        "producer_tool_id": {
          "const": "P0-02",
          "title": "Producer Tool Id",
          "type": "string"
        },
        "producer_tool_version": {
          "minLength": 1,
          "title": "Producer Tool Version",
          "type": "string"
        },
        "source_format": {
          "const": "p0_02_cell_state_evidence_parquet_v0.1",
          "title": "Source Format",
          "type": "string"
        }
      },
      "required": [
        "source_format",
        "producer_tool_id",
        "producer_run_ref",
        "producer_tool_version",
        "artifact_manifest_path",
        "artifact_manifest_sha256",
        "evidence_artifact_id",
        "evidence_path",
        "evidence_sha256",
        "label_level"
      ],
      "title": "ProcessObservationSourceV1",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/process-method-input/v0.2",
  "additionalProperties": false,
