{
  "$defs": {
    "ComparisonDesignRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "blocks_numeric_difference": {
          "title": "Blocks Numeric Difference",
          "type": "boolean"
        },
        "component_ref": {
          "const": "bridge.product-comparison.comparability@0.1.0",
          "default": "bridge.product-comparison.comparability@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "design_state": {
          "enum": [
            "matched",
            "required_mismatch",
            "contextual_mismatch",
            "metadata_missing",
            "completely_confounded",
            "overlap_present",
            "declared",
            "not_recorded",
            "inconsistent"
          ],
          "title": "Design State",
          "type": "string"
        },
        "dimension_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Dimension Id",
          "type": "string"
        },
        "dimension_kind": {
          "enum": [
            "required_equal",
            "contextual",
            "confounder",
            "independence"
          ],
          "title": "Dimension Kind",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "values_by_group": {
          "items": {
            "$ref": "#/$defs/GroupDesignValue"
          },
          "minItems": 1,
          "title": "Values By Group",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "evidence_state",
        "missingness",
        "applicability",
        "assessment_state",
        "dimension_kind",
        "dimension_id",
        "values_by_group",
        "design_state",
        "blocks_numeric_difference"
      ],
      "title": "ComparisonDesignRecord",
      "type": "object"
    },
    "ComparisonGroupRole": {
      "enum": [
        "baseline",
        "comparator",
        "reference_ood"
      ],
      "title": "ComparisonGroupRole",
      "type": "string"
    },
    "ComparisonMethodId": {
      "enum": [
        "CMP-EFFECT",
        "CMP-JS",
        "CMP-CORR",
        "CMP-WASS-1D",
        "STAB-CV"
      ],
      "title": "ComparisonMethodId",
      "type": "string"
    },
    "ComparisonSeriesSemantics": {
      "enum": [
        "probability_mass",
        "matched_features",
        "ordered_values",
        "sample_values"
      ],
      "title": "ComparisonSeriesSemantics",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "GroupDesignValue": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "group_id"
      ],
      "title": "GroupDesignValue",
      "type": "object"
    },
    "MethodEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "analytical_role": {
          "enum": [
            "standardized_sample_effect",
            "probability_mass_distance",
            "matched_feature_correlation",
            "ordered_distribution_distance",
            "within_group_dispersion"
          ],
          "title": "Analytical Role",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "component_ref": {
          "const": "bridge.product-comparison.method-evidence@0.1.0",
          "default": "bridge.product-comparison.method-evidence@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "display_axis_id": {
          "minLength": 1,
          "title": "Display Axis Id",
          "type": "string"
        },
        "estimate_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Name"
        },
        "estimate_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Unit"
        },
        "estimate_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Value"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "group_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Group Ids",
          "type": "array"
        },
        "method_assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Method Assessment State",
          "type": "string"
        },
        "method_id": {
          "$ref": "#/$defs/ComparisonMethodId"
        },
        "method_ref": {
          "minLength": 1,
          "title": "Method Ref",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "n_values": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "N Values",
          "type": "array"
        },
        "raw_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Delta"
        },
        "raw_delta_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Delta Unit"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "series_semantics": {
          "$ref": "#/$defs/ComparisonSeriesSemantics"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "evidence_state",
        "missingness",
        "applicability",
        "assessment_state",
        "task_id",
        "method_id",
        "method_ref",
        "analytical_role",
        "series_semantics",
        "metric_id",
        "group_ids",
        "n_values",
        "method_assessment_state",
        "display_axis_id"
      ],
      "title": "MethodEvidenceRecord",
      "type": "object"
    },
    "MetricDifferenceRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "baseline_analysis_unit_count": {
          "minimum": 1,
          "title": "Baseline Analysis Unit Count",
          "type": "integer"
        },
        "baseline_assessed_count": {
          "minimum": 0,
          "title": "Baseline Assessed Count",
          "type": "integer"
        },
        "baseline_group_id": {
          "minLength": 1,
          "title": "Baseline Group Id",
          "type": "string"
        },
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Value"
        },
        "comparator_analysis_unit_count": {
          "minimum": 1,
          "title": "Comparator Analysis Unit Count",
          "type": "integer"
        },
        "comparator_assessed_count": {
          "minimum": 0,
          "title": "Comparator Assessed Count",
          "type": "integer"
        },
        "comparator_group_id": {
          "minLength": 1,
          "title": "Comparator Group Id",
          "type": "string"
        },
        "comparator_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator Value"
        },
        "comparison_state": {
          "enum": [
            "shadow",
            "missing",
            "unknown",
            "unavailable",
            "alert",
            "not_comparable"
          ],
          "title": "Comparison State",
          "type": "string"
        },
        "component_ref": {
          "const": "bridge.product-comparison.metric-differences@0.1.0",
          "default": "bridge.product-comparison.metric-differences@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "denominator_kind": {
          "minLength": 1,
          "title": "Denominator Kind",
          "type": "string"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease",
            "no_change",
            "not_assessed"
          ],
          "title": "Direction",
          "type": "string"
        },
        "estimand": {
          "const": "difference_in_group_means",
          "default": "difference_in_group_means",
          "title": "Estimand",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "measurement_spec_ref": {
          "minLength": 1,
          "title": "Measurement Spec Ref",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "preparation_record_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Preparation Record Ids",
          "type": "array"
        },
        "raw_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Delta"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "stability_record_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Stability Record Ids",
          "type": "array"
        },
        "uncertainty_state": {
          "const": "not_available",
          "default": "not_available",
          "title": "Uncertainty State",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "evidence_state",
        "missingness",
        "applicability",
        "assessment_state",
        "metric_id",
        "measurement_spec_ref",
        "baseline_group_id",
        "comparator_group_id",
        "comparison_state",
        "direction",
        "unit",
        "denominator_kind",
        "baseline_analysis_unit_count",
        "comparator_analysis_unit_count",
        "baseline_assessed_count",
        "comparator_assessed_count",
        "preparation_record_ids",
        "stability_record_ids"
      ],
      "title": "MetricDifferenceRecord",
      "type": "object"
    },
    "MetricEvidenceState": {
      "enum": [
        "shadow",
        "measured",
        "inferred",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "MetricEvidenceState",
      "type": "string"
    },
    "MetricStabilityVisualizationRecord": {
      "additionalProperties": false,
      "properties": {
        "analysis_unit_count": {
          "minimum": 1,
          "title": "Analysis Unit Count",
          "type": "integer"
        },
        "analysis_unit_coverage_state": {
          "enum": [
            "multiple_analysis_units",
            "single_analysis_unit",
            "incomplete",
            "unavailable"
          ],
          "title": "Analysis Unit Coverage State",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assessed_analysis_unit_count": {
          "minimum": 0,
          "title": "Assessed Analysis Unit Count",
          "type": "integer"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "component_ref": {
          "const": "bridge.product-comparison.metric-differences@0.1.0",
          "default": "bridge.product-comparison.metric-differences@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "declared_independence_group_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Independence Group Count"
        },
        "denominator_kind": {
          "minLength": 1,
          "title": "Denominator Kind",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "independence_state": {
          "enum": [
            "declared",
            "not_recorded",
            "inconsistent"
          ],
          "title": "Independence State",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "observed_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Max"
        },
        "observed_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Min"
        },
        "range_semantics": {
          "const": "observed_min_max",
          "default": "observed_min_max",
          "title": "Range Semantics",
          "type": "string"
        },
        "range_width": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Width"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "evidence_state",
        "missingness",
        "applicability",
        "assessment_state",
        "group_id",
        "metric_id",
        "analysis_unit_count",
        "assessed_analysis_unit_count",
        "independence_state",
        "analysis_unit_coverage_state",
        "unit",
        "denominator_kind"
      ],
      "title": "MetricStabilityVisualizationRecord",
      "type": "object"
    },
    "PreparationMetricRecord": {
      "additionalProperties": false,
      "properties": {
        "analysis_unit_ref": {
          "minLength": 1,
          "title": "Analysis Unit Ref",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "bundle_ref": {
          "minLength": 1,
          "title": "Bundle Ref",
          "type": "string"
        },
        "component_ref": {
          "const": "bridge.product-comparison.metric-differences@0.1.0",
          "default": "bridge.product-comparison.metric-differences@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "declared_independence_group_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Independence Group Count"
        },
        "denominator_kind": {
          "minLength": 1,
          "title": "Denominator Kind",
          "type": "string"
        },
        "denominator_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Value"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "group_role": {
          "$ref": "#/$defs/ComparisonGroupRole"
        },
        "independence_group_refs": {
          "items": {
            "type": "string"
          },
          "title": "Independence Group Refs",
          "type": "array"
        },
        "independence_scope_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independence Scope Ref"
        },
        "independence_state": {
          "enum": [
            "declared",
            "not_recorded",
            "inconsistent"
          ],
          "title": "Independence State",
          "type": "string"
        },
        "interval_semantics": {
          "const": "not_declared",
          "default": "not_declared",
          "title": "Interval Semantics",
          "type": "string"
        },
        "measurement_spec_ref": {
          "minLength": 1,
          "title": "Measurement Spec Ref",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "product_case_ref": {
          "minLength": 1,
          "title": "Product Case Ref",
          "type": "string"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "render_interval": {
          "const": false,
          "default": false,
          "title": "Render Interval",
          "type": "boolean"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "source_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Interval"
        },
        "source_unit_kind": {
          "enum": [
            "sample",
