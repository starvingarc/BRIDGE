{
  "$defs": {
    "BaseGraphRef": {
      "additionalProperties": false,
      "properties": {
        "graph_id": {
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "graph_version": {
          "minimum": 1,
          "title": "Graph Version",
          "type": "integer"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "graph_id",
        "graph_version",
        "manifest_sha256"
      ],
      "title": "BaseGraphRef",
      "type": "object"
    },
    "CaseGraphRef": {
      "additionalProperties": false,
      "properties": {
        "graph_id": {
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "graph_version": {
          "minimum": 1,
          "title": "Graph Version",
          "type": "integer"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "product_case_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "graph_id",
        "graph_version",
        "manifest_sha256",
        "product_case_ref"
      ],
      "title": "CaseGraphRef",
      "type": "object"
    },
    "EvidenceApplicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "not_assessed"
      ],
      "title": "EvidenceApplicability",
      "type": "string"
    },
    "EvidenceLifecycleState": {
      "enum": [
        "active",
        "superseded",
        "invalidated"
      ],
      "title": "EvidenceLifecycleState",
      "type": "string"
    },
    "EvidenceRelation": {
      "enum": [
        "supports",
        "contradicts"
      ],
      "title": "EvidenceRelation",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "formal",
        "shadow",
        "exploratory"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "ExternalCaseEvidenceBinding": {
      "additionalProperties": false,
      "description": "Public, content-addressed Comparison projection without caller input labels.",
      "properties": {
        "applicability": {
          "$ref": "#/$defs/EvidenceApplicability"
        },
        "comparison_claim_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "evidence_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Content Hash",
          "type": "string"
        },
        "evidence_family_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "evidence_ref": {
          "pattern": "^evidence:[a-f0-9]{24}@[1-9][0-9]*$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "evidence_tier": {
          "$ref": "#/$defs/EvidenceTier"
        },
        "lifecycle_state": {
          "$ref": "#/$defs/EvidenceLifecycleState"
        },
        "product_case_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "relation": {
          "$ref": "#/$defs/EvidenceRelation"
        },
        "source_case_graph_ref": {
          "$ref": "#/$defs/CaseGraphRef"
        },
        "source_claim_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "sufficiency_profile_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "tool_run_execution_state": {
          "enum": [
            "succeeded",
            "partial",
            "failed",
            "skipped",
            "not_implemented"
          ],
          "title": "Tool Run Execution State",
          "type": "string"
        }
      },
      "required": [
        "source_case_graph_ref",
        "evidence_ref",
        "evidence_content_hash",
        "product_case_ref",
        "source_claim_ref",
        "comparison_claim_ref",
        "evidence_family_ref",
        "sufficiency_profile_ref",
        "relation",
        "evidence_state",
        "evidence_tier",
        "lifecycle_state",
        "applicability",
        "tool_run_execution_state"
      ],
      "title": "ExternalCaseEvidenceBinding",
      "type": "object"
    },
    "GraphArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9]+)+$",
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "media_type",
        "sha256"
      ],
      "title": "GraphArtifactRef",
      "type": "object"
    },
    "GraphNodeType": {
      "enum": [
        "ProductCase",
        "ProductDefinitionCard",
        "Sample",
        "Preparation",
        "MeasurementSpec",
        "ScoreContract",
        "ToolRun",
        "MeasurementResult",
        "EvidenceRecord",
        "Claim",
        "EvidenceFamily",
        "EvidenceRequirement",
        "EvidenceSufficiencyProfile",
        "ReferenceSnapshot",
        "PriorSnapshot",
        "Artifact",
        "ComparisonRecord",
        "ReconciliationSpec",
        "ReconciliationRecord"
      ],
      "title": "GraphNodeType",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/comparison-evidence-graph-manifest/v0.1",
  "additionalProperties": false,
  "properties": {
    "base_graph_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaseGraphRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonicalization_id": {
      "const": "bridge-canonical-json/v0.1",
      "title": "Canonicalization Id",
      "type": "string"
    },
    "case_graph_refs": {
      "items": {
        "$ref": "#/$defs/CaseGraphRef"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "Case Graph Refs",
      "type": "array"
    },
    "comparison_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "edge_count": {
      "minimum": 0,
      "title": "Edge Count",
      "type": "integer"
    },
    "evidence_records": {
      "$ref": "#/$defs/GraphArtifactRef"
    },
    "evidence_requirements": {
      "$ref": "#/$defs/GraphArtifactRef"
    },
    "external_evidence_bindings": {
      "items": {
        "$ref": "#/$defs/ExternalCaseEvidenceBinding"
      },
      "title": "External Evidence Bindings",
      "type": "array"
    },
    "graph_edges": {
      "$ref": "#/$defs/GraphArtifactRef"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "graph_kind": {
      "const": "comparison",
      "default": "comparison",
      "title": "Graph Kind",
      "type": "string"
    },
    "graph_nodes": {
      "$ref": "#/$defs/GraphArtifactRef"
    },
    "graph_version": {
      "minimum": 1,
      "title": "Graph Version",
      "type": "integer"
    },
    "node_count": {
      "minimum": 0,
      "title": "Node Count",
      "type": "integer"
    },
    "object_counts": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/GraphNodeType"
      },
      "title": "Object Counts",
      "type": "object"
    },
    "reconciliation_records": {
      "$ref": "#/$defs/GraphArtifactRef"
    },
    "source_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Input Hash",
      "type": "string"
    }
  },
  "required": [
    "graph_id",
    "graph_version",
    "canonicalization_id",
    "node_count",
    "edge_count",
    "object_counts",
    "source_input_hash",
    "evidence_records",
    "evidence_requirements",
    "reconciliation_records",
    "graph_nodes",
    "graph_edges",
    "created_at",
    "comparison_ref",
    "case_graph_refs",
    "external_evidence_bindings"
  ],
  "title": "ComparisonEvidenceGraphManifest",
  "type": "object"
}
