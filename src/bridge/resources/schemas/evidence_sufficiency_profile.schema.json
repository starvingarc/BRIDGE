{
  "$defs": {
    "ChecksummedObjectBinding": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "schema_ref",
        "source_sha256"
      ],
      "title": "ChecksummedObjectBinding",
      "type": "object"
    },
    "DataReadinessState": {
      "enum": [
        "adequate",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "DataReadinessState",
      "type": "string"
    },
    "EvidenceSufficiencyState": {
      "enum": [
        "sufficient",
        "limited",
        "insufficient",
        "not_assessed"
      ],
      "title": "EvidenceSufficiencyState",
      "type": "string"
    },
    "MeasurementEvidenceStateCount": {
      "additionalProperties": false,
      "properties": {
        "alert": {
          "minimum": 0,
          "title": "Alert",
          "type": "integer"
        },
        "inferred": {
          "minimum": 0,
          "title": "Inferred",
          "type": "integer"
        },
        "measured": {
          "minimum": 0,
          "title": "Measured",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "negative": {
          "minimum": 0,
          "title": "Negative",
          "type": "integer"
        },
        "prior_only": {
          "minimum": 0,
          "title": "Prior Only",
          "type": "integer"
        },
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "MeasurementEvidenceStateCount",
      "type": "object"
    },
    "ModelRobustnessState": {
      "enum": [
        "validated_applicable",
        "candidate_applicable",
        "unstable",
        "not_applicable",
        "not_required",
        "not_assessed"
      ],
      "title": "ModelRobustnessState",
      "type": "string"
    },
    "P0DomainId": {
      "enum": [
        "target_identity",
        "regional_fidelity",
        "developmental_compatibility",
        "off_target_control",
        "proliferation_stress_response"
      ],
      "title": "P0DomainId",
      "type": "string"
    },
    "PriorApplicabilityState": {
      "enum": [
        "applicable",
        "partially_applicable",
        "inapplicable",
        "not_required",
        "not_assessed"
      ],
      "title": "PriorApplicabilityState",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/evidence-sufficiency-profile/v0.1",
  "additionalProperties": false,
  "properties": {
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_readiness": {
      "$ref": "#/$defs/DataReadinessState"
    },
    "data_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Data Reason Codes",
      "type": "array"
    },
    "deduplicated_evidence_family_ids": {
      "items": {
        "pattern": "^evidence-family:[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "title": "Deduplicated Evidence Family Ids",
      "type": "array"
    },
    "deterministic_run_ref": {
      "pattern": "^run-[a-f0-9]{16}$",
      "title": "Deterministic Run Ref",
      "type": "string"
    },
    "domain_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/P0DomainId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "evidence_sufficiency_state": {
      "$ref": "#/$defs/EvidenceSufficiencyState"
    },
    "gate_rule_spec_ref": {
      "const": "GATE-EVIDENCE-SUFFICIENCY-v0.1",
      "title": "Gate Rule Spec Ref",
      "type": "string"
    },
    "gate_rule_version": {
      "const": "0.1.0",
      "title": "Gate Rule Version",
      "type": "string"
    },
    "limiting_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Limiting Reasons",
      "type": "array"
    },
    "measurement_evidence_state_counts": {
      "$ref": "#/$defs/MeasurementEvidenceStateCount"
    },
    "measurement_result_bindings": {
      "items": {
        "$ref": "#/$defs/ChecksummedObjectBinding"
      },
      "title": "Measurement Result Bindings",
      "type": "array"
    },
    "measurement_result_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "title": "Measurement Result Refs",
      "type": "array"
    },
    "measurement_spec_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "missing_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Missing Requirements",
      "type": "array"
    },
    "model_robustness": {
      "$ref": "#/$defs/ModelRobustnessState"
    },
    "prior_applicability": {
      "$ref": "#/$defs/PriorApplicabilityState"
    },
    "prior_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Prior Reason Codes",
      "type": "array"
    },
    "product_case_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "product_definition_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "pattern": "^evidence-sufficiency-profile:[a-f0-9]{16}:[A-Za-z0-9._:-]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "const": "0.1.0",
      "title": "Profile Version",
      "type": "string"
    },
    "qc_profile_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "robustness_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Robustness Reason Codes",
      "type": "array"
    },
    "score_contract_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score Contract Ref"
    },
    "score_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Score Reason Codes",
      "type": "array"
    },
    "score_state": {
      "const": "unavailable",
      "default": "unavailable",
      "title": "Score State",
      "type": "string"
    },
    "sensitivity_refs": {
      "items": {
        "type": "string"
      },
      "title": "Sensitivity Refs",
      "type": "array"
    },
    "snapshot_refs": {
      "items": {
        "type": "string"
      },
      "title": "Snapshot Refs",
      "type": "array"
    },
    "validation_refs": {
      "items": {
        "type": "string"
      },
      "title": "Validation Refs",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "gate_rule_spec_ref",
    "gate_rule_version",
    "data_readiness",
    "data_reason_codes",
    "model_robustness",
    "robustness_reason_codes",
    "validation_refs",
    "prior_applicability",
    "prior_reason_codes",
    "snapshot_refs",
    "evidence_sufficiency_state",
    "blocking_reasons",
    "limiting_reasons",
    "missing_requirements",
    "score_reason_codes",
    "measurement_result_refs",
    "measurement_result_bindings",
    "measurement_evidence_state_counts",
    "evidence_refs",
    "sensitivity_refs",
    "deduplicated_evidence_family_ids",
    "created_at",
    "deterministic_run_ref"
  ],
  "title": "EvidenceSufficiencyProfile",
  "type": "object"
}
