{
  "$defs": {
    "DataViewBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "biological_unit_manifest_ref": {
                  "type": "null"
                },
                "biological_unit_manifest_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "biological_unit_manifest_ref": {
                  "not": {
                    "type": "null"
                  }
                },
                "biological_unit_manifest_sha256": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "biological_unit_manifest_ref",
                "biological_unit_manifest_sha256"
              ]
            }
          ]
        }
      ],
      "description": "Content-addressed expression view passed between scientific tools.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "biological_unit_manifest_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Ref"
        },
        "biological_unit_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Sha256"
        },
        "matrix_location": {
          "minLength": 1,
          "title": "Matrix Location",
          "type": "string"
        },
        "matrix_semantics": {
          "enum": [
            "raw_counts",
            "normalized_expression"
          ],
          "title": "Matrix Semantics",
          "type": "string"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observation_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Ids Sha256",
          "type": "string"
        },
        "parent_asset_id": {
          "minLength": 1,
          "title": "Parent Asset Id",
          "type": "string"
        },
        "parent_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Asset Sha256",
          "type": "string"
        },
        "sample_or_preparation_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Or Preparation Ref"
        },
        "selection_spec_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Spec Ref"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "view_id": {
          "minLength": 1,
          "title": "View Id",
          "type": "string"
        },
        "view_kind": {
          "enum": [
            "all_observations",
            "qc_selected_observations"
          ],
          "title": "View Kind",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "view_kind",
        "artifact_id",
        "sha256",
        "parent_asset_id",
        "parent_asset_sha256",
        "matrix_location",
        "matrix_semantics",
        "n_observations",
        "observation_ids_sha256"
      ],
      "title": "DataViewBinding",
      "type": "object"
    },
    "DirectedProgramSelection": {
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Program Id",
          "type": "string"
        },
        "source_gene_set": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Gene Set",
          "type": "string"
        }
      },
      "required": [
        "program_id",
        "source_gene_set"
      ],
      "title": "DirectedProgramSelection",
      "type": "object"
    },
    "DirectedResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "hu_pluripotency_csv",
            "oflanagan_core_csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "license_ref": {
          "minLength": 1,
          "title": "License Ref",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*(?::[^\\s]+)?$",
          "title": "Resource Ref",
          "type": "string"
        },
        "resource_version": {
          "minLength": 1,
          "title": "Resource Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Family Id",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://\\S+$",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "resource_ref",
        "resource_version",
        "source_family_id",
        "path",
        "sha256",
        "source_url",
        "license_ref",
        "format"
      ],
      "title": "DirectedResourceBinding",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/exploratory-process-input/v0.3",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_view": {
      "$ref": "#/$defs/DataViewBinding"
    },
    "gene_coverage_policy": {
      "enum": [
        "complete_only",
        "observed_subset"
      ],
      "title": "Gene Coverage Policy",
      "type": "string"
    },
    "gene_symbol_column": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gene Symbol Column"
    },
    "input_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Input Id",
      "type": "string"
    },
    "object_version": {
      "const": "0.3.0",
      "title": "Object Version",
      "type": "string"
    },
    "programs": {
      "items": {
        "$ref": "#/$defs/DirectedProgramSelection"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Programs",
      "type": "array"
    },
    "resource": {
      "$ref": "#/$defs/DirectedResourceBinding"
    },
    "source_family_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Source Family Id",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "input_id",
    "source_family_id",
    "data_view",
    "resource",
    "programs",
    "gene_coverage_policy",
    "created_at"
  ],
  "title": "DirectedProgramInput",
  "type": "object"
}
