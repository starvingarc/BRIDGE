          "default": null,
          "title": "Numerator"
        },
        "orthogonal_follow_up_refs": {
          "items": {
            "type": "string"
          },
          "title": "Orthogonal Follow Up Refs",
          "type": "array"
        },
        "process_attribution": {
          "$ref": "#/$defs/ProcessAttributionState"
        },
        "process_step_ids": {
          "items": {
            "type": "string"
          },
          "title": "Process Step Ids",
          "type": "array"
        },
        "program_id": {
          "minLength": 1,
          "title": "Program Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
