        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "source_evidence_state": {
          "minLength": 1,
          "title": "Source Evidence State",
          "type": "string"
        },
        "stage_id": {
          "minLength": 1,
