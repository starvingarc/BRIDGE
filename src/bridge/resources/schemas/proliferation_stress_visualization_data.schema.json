        "minimum_gene_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Gene Coverage",
          "type": "number"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
