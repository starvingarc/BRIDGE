{
  "$defs": {
    "AnalysisScope": {
      "enum": [
        "whole_product",
        "state_specific"
      ],
      "title": "AnalysisScope",
      "type": "string"
    },
    "AssessmentState": {
      "enum": [
        "available",
        "not_assessed"
      ],
      "type": "string"
    },
    "CellCycleVisualizationRecord": {
      "additionalProperties": false,
      "properties": {
        "analysis_scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "analysis_unit_ref": {
          "minLength": 1,
          "title": "Analysis Unit Ref",
          "type": "string"
        },
        "assessment_state": {
          "$ref": "#/$defs/AssessmentState"
        },
        "cell_state_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell State Id"
        },
        "component_ref": {
          "const": "bridge.proliferation-stress.cell-cycle@0.1.0",
          "default": "bridge.proliferation-stress.cell-cycle@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "cycling_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycling Fraction"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "const": "shadow",
          "default": "shadow",
          "title": "Evidence State",
          "type": "string"
        },
        "expression_view_scope": {
          "$ref": "#/$defs/ExpressionViewScope"
        },
        "g1_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "G1 Count"
        },
        "g1_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "G1 Fraction"
        },
        "g2m_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "G2M Count"
        },
        "g2m_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "G2M Fraction"
        },
        "g2m_gene_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "G2M Gene Coverage",
          "type": "number"
        },
        "gene_coverage_basis": {
          "const": "scanpy_s_and_g2m_phase_gene_lists_assessed_separately",
          "default": "scanpy_s_and_g2m_phase_gene_lists_assessed_separately",
          "title": "Gene Coverage Basis",
          "type": "string"
        },
        "independence_group_ref": {
          "minLength": 1,
          "title": "Independence Group Ref",
          "type": "string"
        },
        "mean_g2m_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean G2M Score"
        },
        "mean_s_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean S Score"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observation_unit": {
          "const": "cells",
          "default": "cells",
          "title": "Observation Unit",
          "type": "string"
        },
        "phase_assignment_state": {
          "enum": [
            "transcriptionally_assigned",
            "not_assessed"
          ],
          "title": "Phase Assignment State",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "s_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "S Count"
        },
        "s_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "S Fraction"
        },
        "s_gene_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "S Gene Coverage",
          "type": "number"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "score_unit": {
          "const": "scanpy_relative_expression_score",
          "default": "scanpy_relative_expression_score",
          "title": "Score Unit",
          "type": "string"
        },
        "selected_expression_view_ref": {
          "minLength": 1,
          "title": "Selected Expression View Ref",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "evidence_ids",
        "assessment_state",
        "analysis_scope",
        "expression_view_scope",
        "analysis_unit_ref",
        "independence_group_ref",
        "selected_expression_view_ref",
        "n_observations",
        "s_gene_coverage",
        "g2m_gene_coverage",
        "phase_assignment_state"
      ],
      "title": "CellCycleVisualizationRecord",
      "type": "object"
    },
    "ComponentState": {
      "enum": [
        "available",
        "partial",
        "not_assessed"
      ],
      "type": "string"
    },
    "ExpressionViewScope": {
      "enum": [
        "selected_expression_view",
        "candidate_state_subset_of_selected_expression_view"
      ],
      "type": "string"
    },
    "MethodAgreementVisualizationRecord": {
      "additionalProperties": false,
      "properties": {
        "agreement_semantics": {
          "const": "analysis_unit_rank_correlation_not_independent_replicate_validation",
          "default": "analysis_unit_rank_correlation_not_independent_replicate_validation",
          "title": "Agreement Semantics",
          "type": "string"
        },
        "analysis_scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "assessment_state": {
          "$ref": "#/$defs/AssessmentState"
        },
        "cell_state_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell State Id"
        },
        "component_ref": {
          "const": "bridge.proliferation-stress.program-score-summary@0.1.0",
          "default": "bridge.proliferation-stress.program-score-summary@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "display_scope": {
          "const": "table_only",
          "default": "table_only",
          "title": "Display Scope",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "const": "shadow",
          "default": "shadow",
          "title": "Evidence State",
          "type": "string"
        },
        "left_method_id": {
          "const": "PROC-SCORE-SCANPY",
          "default": "PROC-SCORE-SCANPY",
          "title": "Left Method Id",
          "type": "string"
        },
        "n_analysis_units": {
          "minimum": 0,
          "title": "N Analysis Units",
          "type": "integer"
        },
        "program_id": {
          "minLength": 1,
          "title": "Program Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "right_method_id": {
          "const": "PROC-SCORE-DECOUPLER",
          "default": "PROC-SCORE-DECOUPLER",
          "title": "Right Method Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "selected_expression_view_ref": {
          "minLength": 1,
          "title": "Selected Expression View Ref",
          "type": "string"
        },
        "spearman_rho": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spearman Rho"
        }
      },
      "required": [
        "record_id",
        "evidence_ids",
        "assessment_state",
        "program_id",
        "analysis_scope",
        "selected_expression_view_ref",
        "n_analysis_units"
      ],
      "title": "MethodAgreementVisualizationRecord",
      "type": "object"
    },
    "ProcessAttributionState": {
      "enum": [
        "conditional_association",
        "cannot_attribute",
        "not_requested"
      ],
      "title": "ProcessAttributionState",
      "type": "string"
    },
    "ProcessMethodId": {
      "enum": [
        "PROC-SCORE-SCANPY",
        "PROC-SCORE-DECOUPLER",
        "PROC-CYCLE-SCANPY",
        "PROC-CYCLE-AGG"
