{
  "$defs": {
    "DataViewBinding": {
      "additionalProperties": false,
      "description": "Content-addressed expression view passed between scientific tools.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "biological_unit_manifest_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Ref"
        },
        "biological_unit_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Sha256"
        },
        "matrix_location": {
          "minLength": 1,
          "title": "Matrix Location",
          "type": "string"
        },
        "matrix_semantics": {
          "enum": [
            "raw_counts",
            "normalized_expression"
          ],
          "title": "Matrix Semantics",
          "type": "string"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observation_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Ids Sha256",
          "type": "string"
        },
        "parent_asset_id": {
          "minLength": 1,
          "title": "Parent Asset Id",
          "type": "string"
        },
        "parent_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Asset Sha256",
          "type": "string"
        },
        "sample_or_preparation_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Or Preparation Ref"
        },
        "selection_spec_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Spec Ref"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "view_id": {
          "minLength": 1,
          "title": "View Id",
          "type": "string"
        },
        "view_kind": {
          "enum": [
            "all_observations",
            "qc_selected_observations"
          ],
          "title": "View Kind",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "view_kind",
        "artifact_id",
        "sha256",
        "parent_asset_id",
        "parent_asset_sha256",
        "matrix_location",
        "matrix_semantics",
        "n_observations",
        "observation_ids_sha256"
      ],
      "title": "DataViewBinding",
      "type": "object"
    },
    "ReadinessState": {
      "enum": [
        "ready",
        "limited",
        "blocked",
        "not_assessed",
        "not_applicable"
      ],
      "title": "ReadinessState",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/qc-readiness-profile/v0.1",
  "additionalProperties": false,
  "properties": {
    "ambient_assessment": {
      "additionalProperties": true,
      "title": "Ambient Assessment",
      "type": "object"
    },
    "assay": {
      "title": "Assay",
      "type": "string"
    },
    "assay_spec_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assay Spec Id"
    },
    "blocking_issues": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Issues",
      "type": "array"
    },
    "cell_calling_assessment": {
      "additionalProperties": true,
      "title": "Cell Calling Assessment",
      "type": "object"
    },
    "cell_qc": {
      "additionalProperties": true,
      "title": "Cell Qc",
      "type": "object"
    },
    "data_views": {
      "additionalProperties": true,
      "title": "Data Views",
      "type": "object"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "doublet_assessment": {
      "additionalProperties": true,
      "title": "Doublet Assessment",
      "type": "object"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "input_level": {
      "title": "Input Level",
      "type": "string"
    },
    "matrix_provenance": {
      "additionalProperties": true,
      "title": "Matrix Provenance",
      "type": "object"
    },
    "measurement_spec_status": {
      "default": "not_selected",
      "title": "Measurement Spec Status",
      "type": "string"
    },
    "measurement_spec_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Spec Version"
    },
    "metadata_completeness": {
      "additionalProperties": true,
      "title": "Metadata Completeness",
      "type": "object"
    },
    "missing_inputs": {
      "items": {
        "type": "string"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "module_eligibility": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Module Eligibility",
      "type": "object"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "readiness_state": {
      "$ref": "#/$defs/ReadinessState"
    },
    "schema_integrity": {
      "additionalProperties": true,
      "title": "Schema Integrity",
      "type": "object"
    },
    "score_state": {
      "default": "unavailable",
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "selected_data_view": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataViewBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "upstream_library_qc": {
      "additionalProperties": true,
      "title": "Upstream Library Qc",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "input_level",
    "assay",
    "readiness_state",
    "schema_integrity",
    "metadata_completeness",
    "matrix_provenance",
    "upstream_library_qc",
    "cell_qc",
    "doublet_assessment",
    "cell_calling_assessment",
    "ambient_assessment",
    "data_views",
    "module_eligibility"
  ],
  "title": "QCReadinessProfile",
  "type": "object"
}
