{
  "$defs": {
    "LineageRole": {
      "enum": [
        "target",
        "acceptable_adjacent",
        "not_target",
        "unresolved"
      ],
      "title": "LineageRole",
      "type": "string"
    },
    "RegionalRole": {
      "enum": [
        "target_region",
        "acceptable_adjacent_region",
        "regional_shift",
        "not_applicable",
        "unresolved"
      ],
      "title": "RegionalRole",
      "type": "string"
    },
    "StateRoleAssignment": {
      "additionalProperties": false,
      "properties": {
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "lineage_role": {
          "$ref": "#/$defs/LineageRole"
        },
        "provenance_refs": {
          "items": {
            "$ref": "#/$defs/VersionedObjectRef"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "regional_role": {
          "$ref": "#/$defs/RegionalRole"
        },
        "state_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "label_level",
        "lineage_role",
        "regional_role"
      ],
      "title": "StateRoleAssignment",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/state-role-map/v0.1",
  "additionalProperties": false,
  "properties": {
    "annotation_vocabulary_ref": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
      "title": "Annotation Vocabulary Ref",
      "type": "string"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/StateRoleAssignment"
      },
      "minItems": 1,
      "title": "Assignments",
      "type": "array"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "product_definition_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "review_state": {
      "enum": [
        "draft",
        "reviewed",
        "frozen"
      ],
      "title": "Review State",
      "type": "string"
    },
    "role_map_id": {
      "pattern": "^state-role-map:[A-Za-z0-9._:-]+$",
      "title": "Role Map Id",
      "type": "string"
    },
    "role_map_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Role Map Version",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "role_map_id",
    "role_map_version",
    "product_definition_ref",
    "annotation_vocabulary_ref",
    "review_state",
    "assignments"
  ],
  "title": "StateRoleMap",
  "type": "object"
}
