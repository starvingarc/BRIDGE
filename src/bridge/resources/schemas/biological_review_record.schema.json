{
  "$defs": {
    "ReviewerSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "reviewer_id": {
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_role": {
          "enum": [
            "bridge_scientific_lead",
            "chen_team_reviewer"
          ],
          "title": "Reviewer Role",
          "type": "string"
        },
        "signature_base64": {
          "maxLength": 96,
          "minLength": 80,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        }
      },
      "required": [
        "reviewer_id",
        "reviewer_role",
        "key_id",
        "signed_at",
        "object_sha256",
        "signature_base64"
      ],
      "title": "ReviewerSignature",
      "type": "object"
    },
    "StateReviewCard": {
      "additionalProperties": false,
      "properties": {
        "allowed_interpretations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Interpretations",
          "type": "array"
        },
        "anatomy_scope": {
          "title": "Anatomy Scope",
          "type": "string"
        },
        "confusion_states": {
          "items": {
            "type": "string"
          },
          "title": "Confusion States",
          "type": "array"
        },
        "count_source_id": {
          "title": "Count Source Id",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "derivation_summary": {
          "title": "Derivation Summary",
          "type": "string"
        },
        "developmental_scope": {
          "title": "Developmental Scope",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "exploratory_markers": {
          "items": {
            "type": "string"
          },
          "title": "Exploratory Markers",
          "type": "array"
        },
        "forbidden_interpretations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Forbidden Interpretations",
          "type": "array"
        },
        "level": {
          "enum": [
            "L1",
            "L2"
          ],
          "title": "Level",
          "type": "string"
        },
        "n_donors": {
          "minimum": 0,
          "title": "N Donors",
          "type": "integer"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "negative_markers": {
          "items": {
            "type": "string"
          },
          "title": "Negative Markers",
          "type": "array"
        },
        "parent_state_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent State Ids",
          "type": "array"
        },
        "positive_markers": {
          "items": {
            "type": "string"
          },
          "title": "Positive Markers",
          "type": "array"
        },
        "review_blockers": {
          "items": {
            "type": "string"
          },
          "title": "Review Blockers",
          "type": "array"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "state_id": {
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "display_name",
        "level",
        "definition",
        "anatomy_scope",
        "developmental_scope",
        "source_ids",
        "count_source_id",
        "derivation_summary",
        "n_donors",
        "n_observations",
        "allowed_interpretations",
        "forbidden_interpretations"
      ],
      "title": "StateReviewCard",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/biological-review-record/v0.1",
  "additionalProperties": false,
  "properties": {
    "alias_decisions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Alias Decisions",
      "type": "object"
    },
    "conflict_exclusions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Conflict Exclusions",
      "type": "object"
    },
    "product_definition_card_ref": {
      "title": "Product Definition Card Ref",
      "type": "string"
    },
    "product_definition_review_status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Product Definition Review Status",
      "type": "string"
    },
    "review_record_id": {
      "title": "Review Record Id",
      "type": "string"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/ReviewerSignature"
      },
      "title": "Signatures",
      "type": "array"
    },
    "state_reviews": {
      "items": {
        "$ref": "#/$defs/StateReviewCard"
      },
      "minItems": 1,
      "title": "State Reviews",
      "type": "array"
    },
    "state_role_map_ref": {
      "title": "State Role Map Ref",
      "type": "string"
    },
    "state_role_map_review_status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "State Role Map Review Status",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "partially_approved",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "vocabulary_ref": {
      "title": "Vocabulary Ref",
      "type": "string"
    }
  },
  "required": [
    "review_record_id",
    "version",
    "vocabulary_ref",
    "status",
    "product_definition_card_ref",
    "state_role_map_ref",
    "state_reviews"
  ],
  "title": "BiologicalReviewRecord",
  "type": "object"
}
