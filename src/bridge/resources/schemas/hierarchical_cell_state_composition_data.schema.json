{
  "$defs": {
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "GroupStateCorrespondenceRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "const": "applicable",
          "default": "applicable",
          "title": "Applicability",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "group_denominator": {
          "exclusiveMinimum": 0,
          "title": "Group Denominator",
          "type": "integer"
        },
        "group_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Group Fraction",
          "type": "number"
        },
        "group_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "L1",
            "L2"
          ],
          "title": "Level",
          "type": "string"
        },
        "missingness": {
          "const": "available",
          "default": "available",
          "title": "Missingness",
          "type": "string"
        },
        "parent_denominator": {
          "exclusiveMinimum": 0,
          "title": "Parent Denominator",
          "type": "integer"
        },
        "parent_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Parent Fraction",
          "type": "number"
        },
        "parent_state_id": {
          "anyOf": [
            {
              "pattern": "^L1:[A-Za-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent State Id"
        },
        "prediction_sets": {
          "items": {
            "$ref": "#/$defs/PredictionSetSummary"
          },
          "title": "Prediction Sets",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "resolution_state": {
          "enum": [
            "resolved",
            "source_conflict",
            "subtype_unresolved",
            "unavailable"
          ],
          "title": "Resolution State",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "state_id": {
          "anyOf": [
            {
              "pattern": "^L[12]:[A-Za-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Id"
        },
        "value_semantics": {
          "const": "reference_correspondence_fraction",
          "default": "reference_correspondence_fraction",
          "title": "Value Semantics",
          "type": "string"
        },
        "whole_product_denominator": {
          "exclusiveMinimum": 0,
          "title": "Whole Product Denominator",
          "type": "integer"
        },
        "whole_product_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Whole Product Fraction",
          "type": "number"
        }
      },
      "required": [
        "record_id",
        "group_id",
        "level",
        "resolution_state",
        "count",
        "group_denominator",
        "group_fraction",
        "whole_product_denominator",
        "whole_product_fraction",
        "parent_denominator",
        "parent_fraction",
        "evidence_state",
        "evidence_ids"
      ],
      "title": "GroupStateCorrespondenceRecord",
      "type": "object"
    },
    "HierarchicalCompositionRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "denominator_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Scope"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "level": {
          "enum": [
            "L1",
            "L2",
            "status"
          ],
          "title": "Level",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Denominator"
        },
        "parent_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Fraction"
        },
        "parent_state_id": {
          "anyOf": [
            {
              "pattern": "^L1:[A-Za-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent State Id"
        },
        "partition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Partition Id",
          "type": "string"
        },
        "prediction_sets": {
          "items": {
            "$ref": "#/$defs/PredictionSetSummary"
          },
          "title": "Prediction Sets",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "state",
            "resolution"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "resolution_state": {
          "enum": [
            "resolved",
            "source_conflict",
            "subtype_unresolved",
            "unavailable",
            "not_assessed"
          ],
          "title": "Resolution State",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "state_id": {
          "anyOf": [
            {
              "pattern": "^L[12]:[A-Za-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Id"
        },
        "supporting_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Ids",
          "type": "array"
        },
        "whole_product_denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whole Product Denominator"
        },
        "whole_product_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whole Product Fraction"
        }
      },
      "required": [
        "record_id",
        "record_kind",
        "partition_id",
        "display_name",
        "level",
        "order",
        "resolution_state",
        "evidence_state",
        "applicability",
        "missingness",
        "evidence_ids"
      ],
      "title": "HierarchicalCompositionRecord",
      "type": "object"
    },
    "PredictionSetSummary": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Fraction",
          "type": "number"
        },
        "state_ids": {
          "items": {
            "type": "string"
          },
          "title": "State Ids",
          "type": "array"
        }
      },
      "required": [
        "state_ids",
        "count",
        "denominator",
        "fraction"
      ],
      "title": "PredictionSetSummary",
      "type": "object"
    },
    "ProductGroup": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "group_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "user_label",
            "exploratory_leiden"
          ],
          "title": "Source",
          "type": "string"
        },
        "whole_product_denominator": {
          "exclusiveMinimum": 0,
          "title": "Whole Product Denominator",
          "type": "integer"
        },
        "whole_product_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Whole Product Fraction",
          "type": "number"
        }
      },
      "required": [
        "group_id",
        "display_name",
        "source",
        "count",
        "whole_product_denominator",
        "whole_product_fraction"
      ],
      "title": "ProductGroup",
      "type": "object"
    },
    "ProductGroupingProvenance": {
      "additionalProperties": false,
      "properties": {
        "grouping_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grouping Hash"
        },
        "grouping_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grouping Key"
        },
        "method": {
          "additionalProperties": true,
          "title": "Method",
          "type": "object"
        },
        "n_groups": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Groups"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source": {
          "enum": [
            "user_label",
            "exploratory_leiden",
            "whole_product"
          ],
          "title": "Source",
          "type": "string"
        },
        "state": {
          "enum": [
            "user_provided",
            "generated",
            "not_generated"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "source",
        "method"
      ],
      "title": "ProductGroupingProvenance",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/hierarchical-cell-state-composition-data/v0.1",
  "additionalProperties": false,
  "properties": {
    "alt_text": {
      "maxLength": 240,
      "minLength": 40,
      "title": "Alt Text",
      "type": "string"
    },
    "annotation_vocabulary_ref": {
      "minLength": 1,
      "title": "Annotation Vocabulary Ref",
      "type": "string"
    },
    "annotation_vocabulary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Annotation Vocabulary Sha256",
      "type": "string"
    },
    "composition_records": {
      "items": {
        "$ref": "#/$defs/HierarchicalCompositionRecord"
      },
      "minItems": 2,
      "title": "Composition Records",
      "type": "array"
    },
    "denominator_scope": {
      "minLength": 1,
      "title": "Denominator Scope",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "group_records": {
      "items": {
        "$ref": "#/$defs/GroupStateCorrespondenceRecord"
      },
      "title": "Group Records",
      "type": "array"
    },
    "grouping": {
      "$ref": "#/$defs/ProductGroupingProvenance"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/ProductGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "input_view_ref": {
      "minLength": 1,
      "title": "Input View Ref",
      "type": "string"
    },
    "input_view_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input View Sha256",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "long_description": {
      "minLength": 80,
      "title": "Long Description",
      "type": "string"
    },
    "object_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "observation_unit": {
      "enum": [
        "cells",
        "nuclei",
        "observations"
      ],
      "title": "Observation Unit",
      "type": "string"
    },
    "producer_run_ref": {
      "pattern": "^run:[A-Za-z0-9._:-]+$",
      "title": "Producer Run Ref",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^hierarchical-cell-state-composition:[A-Za-z0-9._-]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "schema_ref": {
      "const": "bridge://schemas/hierarchical-cell-state-composition-data/v0.1",
      "default": "bridge://schemas/hierarchical-cell-state-composition-data/v0.1",
      "title": "Schema Ref",
      "type": "string"
    },
    "scientific_status": {
      "const": "candidate",
      "default": "candidate",
      "title": "Scientific Status",
      "type": "string"
    },
    "source_conflict_assessed": {
      "title": "Source Conflict Assessed",
      "type": "boolean"
    },
    "whole_product_denominator": {
      "exclusiveMinimum": 0,
      "title": "Whole Product Denominator",
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "producer_run_ref",
    "observation_unit",
    "whole_product_denominator",
    "denominator_scope",
    "input_view_ref",
    "input_view_sha256",
    "annotation_vocabulary_ref",
    "annotation_vocabulary_sha256",
    "source_conflict_assessed",
    "grouping",
    "composition_records",
    "evidence_ids",
    "limitations",
    "alt_text",
    "long_description"
  ],
  "title": "HierarchicalCellStateCompositionDataV1",
  "type": "object"
}
