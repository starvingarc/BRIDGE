{
  "$defs": {
    "HardSoftSensitivityRecord": {
      "additionalProperties": false,
      "properties": {
        "hard_fraction": {
          "title": "Hard Fraction",
          "type": "number"
        },
        "hard_minus_soft": {
          "title": "Hard Minus Soft",
          "type": "number"
        },
        "product_role": {
          "$ref": "#/$defs/ProductRole"
        },
        "soft_fraction": {
          "title": "Soft Fraction",
          "type": "number"
        }
      },
      "required": [
        "product_role",
        "soft_fraction",
        "hard_fraction",
        "hard_minus_soft"
      ],
      "title": "HardSoftSensitivityRecord",
      "type": "object"
    },
    "MethodExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "execution_state": {
          "$ref": "#/$defs/MethodExecutionState"
        },
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "method_id": {
          "$ref": "#/$defs/OffTargetMethodId"
        },
        "method_ref": {
          "pattern": "^METHOD-[A-Z0-9-]+$",
          "title": "Method Ref",
          "type": "string"
        },
        "package_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Package Versions",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "method_id",
        "method_ref",
        "implementation",
        "execution_state",
        "package_versions",
        "reason_codes"
      ],
      "title": "MethodExecutionRecord",
      "type": "object"
    },
    "MethodExecutionState": {
      "enum": [
        "succeeded",
        "not_assessed"
      ],
      "title": "MethodExecutionState",
      "type": "string"
    },
    "OODDecisionState": {
      "enum": [
        "supported",
        "unknown",
        "ood",
        "not_assessed"
      ],
      "title": "OODDecisionState",
      "type": "string"
    },
    "OODDisagreementRecord": {
      "additionalProperties": false,
      "properties": {
        "assessed_channel_count": {
          "title": "Assessed Channel Count",
          "type": "integer"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "disagreement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disagreement"
        },
        "distinct_source_family_count": {
          "title": "Distinct Source Family Count",
          "type": "integer"
        },
        "family_states": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Family States",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "assessed_channel_count",
        "distinct_source_family_count",
        "family_states",
        "disagreement",
        "assessment_state",
        "reason_codes"
      ],
      "title": "OODDisagreementRecord",
      "type": "object"
    },
    "OODEnsembleRecord": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "decision_state": {
          "$ref": "#/$defs/OODDecisionState"
        },
        "distinct_source_family_count": {
          "title": "Distinct Source Family Count",
          "type": "integer"
        },
        "family_vote_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Family Vote Counts",
          "type": "object"
        },
        "matched_reason_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched Reason Id"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "decision_state",
        "distinct_source_family_count",
        "family_vote_counts",
        "matched_reason_id",
        "assessment_state",
        "reason_codes"
      ],
      "title": "OODEnsembleRecord",
      "type": "object"
    },
    "OffTargetMethodId": {
      "enum": [
        "COMP-EXACT",
        "COMP-HARD-SENS",
        "COMP-HBOOT",
        "RARE-EXACT",
        "RARE-SPIKEIN",
        "RARE-SCOPIT",
        "OOD-DISAGREE",
        "OOD-ENSEMBLE"
      ],
      "title": "OffTargetMethodId",
      "type": "string"
    },
    "ProductRole": {
      "enum": [
        "target",
        "acceptable_adjacent",
        "known_off_target",
        "role_unresolved"
      ],
      "title": "ProductRole",
      "type": "string"
    },
    "ProportionInterval": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "confidence_level": {
          "title": "Confidence Level",
          "type": "number"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "method_id": {
          "$ref": "#/$defs/OffTargetMethodId"
        },
        "n_independence_groups": {
          "title": "N Independence Groups",
          "type": "integer"
        },
        "n_observations": {
          "title": "N Observations",
          "type": "integer"
        },
        "numerator_kind": {
          "enum": [
            "hard_count",
            "soft_mass"
          ],
          "title": "Numerator Kind",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "scope_id": {
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        }
      },
      "required": [
        "scope_id",
        "method_id",
        "numerator_kind",
        "estimate",
        "lower",
        "upper",
        "confidence_level",
        "n_observations",
        "n_independence_groups",
        "assessment_state",
        "reason_codes"
      ],
      "title": "ProportionInterval",
      "type": "object"
    },
    "RarePlanningRecord": {
      "additionalProperties": false,
      "properties": {
        "assumption_codes": {
          "items": {
            "type": "string"
          },
          "title": "Assumption Codes",
          "type": "array"
        },
        "desired_detection_probability": {
          "title": "Desired Detection Probability",
          "type": "number"
        },
        "expected_frequency_fraction": {
          "title": "Expected Frequency Fraction",
          "type": "number"
        },
        "required_observations": {
          "title": "Required Observations",
          "type": "integer"
        },
        "state_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "expected_frequency_fraction",
        "desired_detection_probability",
        "required_observations",
        "assumption_codes"
      ],
      "title": "RarePlanningRecord",
      "type": "object"
    },
    "SpikeInCalibrationRecord": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "candidate_detection_limit_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Detection Limit Fraction"
        },
        "curve": {
          "items": {
            "$ref": "#/$defs/SpikeInCurvePoint"
          },
          "title": "Curve",
          "type": "array"
        },
        "false_positive_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "False Positive Fraction"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "state_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "candidate_detection_limit_fraction",
        "false_positive_fraction",
        "assessment_state",
        "curve",
        "reason_codes"
      ],
      "title": "SpikeInCalibrationRecord",
      "type": "object"
    },
    "SpikeInCurvePoint": {
      "additionalProperties": false,
      "properties": {
        "detected_trial_count": {
          "title": "Detected Trial Count",
          "type": "integer"
        },
        "detection_lower": {
          "title": "Detection Lower",
          "type": "number"
        },
        "detection_rate": {
          "title": "Detection Rate",
          "type": "number"
        },
        "detection_upper": {
          "title": "Detection Upper",
          "type": "number"
        },
        "spike_fraction": {
          "title": "Spike Fraction",
          "type": "number"
        },
        "trial_count": {
          "title": "Trial Count",
          "type": "integer"
        }
      },
      "required": [
        "spike_fraction",
        "trial_count",
        "detected_trial_count",
        "detection_rate",
        "detection_lower",
        "detection_upper"
      ],
      "title": "SpikeInCurvePoint",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/off-target-method-bundle/v0.1",
  "additionalProperties": false,
  "properties": {
    "analysis_unit_refs": {
      "items": {
        "type": "string"
      },
      "title": "Analysis Unit Refs",
      "type": "array"
    },
    "biological_unit_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Biological Unit Manifest Sha256",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^off-target-method-bundle:[A-Za-z0-9._:-]+$",
      "title": "Bundle Id",
      "type": "string"
    },
    "bundle_version": {
      "const": "0.1.0",
      "title": "Bundle Version",
      "type": "string"
    },
    "composition_intervals": {
      "items": {
        "$ref": "#/$defs/ProportionInterval"
      },
      "title": "Composition Intervals",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_state": {
      "const": "shadow",
      "title": "Evidence State",
      "type": "string"
    },
    "executions": {
      "items": {
        "$ref": "#/$defs/MethodExecutionRecord"
      },
      "title": "Executions",
      "type": "array"
    },
    "hard_soft_sensitivity": {
      "items": {
        "$ref": "#/$defs/HardSoftSensitivityRecord"
      },
      "title": "Hard Soft Sensitivity",
      "type": "array"
    },
    "independence_group_refs": {
      "items": {
        "type": "string"
      },
      "title": "Independence Group Refs",
      "type": "array"
    },
    "method_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Method Input Sha256",
      "type": "string"
    },
    "method_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Method Spec Sha256",
      "type": "string"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "ood_disagreement": {
      "anyOf": [
        {
          "$ref": "#/$defs/OODDisagreementRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "ood_ensemble": {
      "anyOf": [
        {
          "$ref": "#/$defs/OODEnsembleRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "planning_records": {
      "items": {
        "$ref": "#/$defs/RarePlanningRecord"
      },
      "title": "Planning Records",
      "type": "array"
    },
    "rare_intervals": {
      "items": {
        "$ref": "#/$defs/ProportionInterval"
      },
      "title": "Rare Intervals",
      "type": "array"
    },
    "score_state": {
      "const": "unavailable",
      "title": "Score State",
      "type": "string"
    },
    "spike_in_calibrations": {
      "items": {
        "$ref": "#/$defs/SpikeInCalibrationRecord"
      },
      "title": "Spike In Calibrations",
      "type": "array"
    },
    "tool_id": {
      "const": "P0-05",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "bundle_id",
    "bundle_version",
    "tool_id",
    "tool_version",
    "method_spec_sha256",
    "method_input_sha256",
    "biological_unit_manifest_sha256",
    "analysis_unit_refs",
    "independence_group_refs",
    "executions",
    "composition_intervals",
    "hard_soft_sensitivity",
    "rare_intervals",
    "spike_in_calibrations",
    "planning_records",
    "ood_disagreement",
    "ood_ensemble",
    "evidence_state",
    "score_state",
    "created_at"
  ],
  "title": "OffTargetMethodBundle",
  "type": "object"
}
