{
  "$defs": {
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/measurement-result/v0.2",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "source_execution_state": {
              "type": "null"
            },
            "source_run_ref": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "source_execution_state": {
              "not": {
                "type": "null"
              }
            },
            "source_run_ref": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "source_run_ref",
            "source_execution_state"
          ]
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "denominator": {
              "type": "null"
            },
            "numerator": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "denominator": {
              "not": {
                "type": "null"
              }
            },
            "numerator": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "evidence_state": {
            "enum": [
              "missing",
              "unavailable"
            ]
          }
        },
        "required": [
          "evidence_state"
        ]
      },
      "then": {
        "properties": {
          "denominator": {
            "type": "null"
          },
          "interval": {
            "type": "null"
          },
          "numerator": {
            "type": "null"
          },
          "raw_value": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "denominator": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denominator"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_state": {
      "$ref": "#/$defs/EvidenceState"
    },
    "interval": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interval"
    },
    "interval_confidence_level": {
      "anyOf": [
        {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interval Confidence Level"
    },
    "interval_method_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interval Method Ref"
    },
    "measurement_id": {
      "title": "Measurement Id",
      "type": "string"
    },
    "measurement_spec_id": {
      "title": "Measurement Spec Id",
      "type": "string"
    },
    "measurement_spec_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Spec Version"
    },
    "metric_name": {
      "title": "Metric Name",
      "type": "string"
    },
    "numerator": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numerator"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "raw_value": {
      "title": "Raw Value"
    },
    "score_state": {
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "source_execution_state": {
      "anyOf": [
        {
          "enum": [
            "succeeded",
            "partial"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Execution State"
    },
    "source_run_ref": {
      "anyOf": [
        {
          "pattern": "^tool-run:[A-Za-z0-9._:-]+@[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Ref"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "unknown_scope": {
      "anyOf": [
        {
          "enum": [
            "identity",
            "role",
            "measurement"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unknown Scope"
    }
  },
  "required": [
    "measurement_id",
    "measurement_spec_id",
    "metric_name",
    "raw_value",
    "score_state",
    "evidence_state"
  ],
  "title": "MeasurementResultV2",
  "type": "object"
}
