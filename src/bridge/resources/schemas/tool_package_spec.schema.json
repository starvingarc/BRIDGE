{
  "$defs": {
    "ImplementationState": {
      "enum": [
        "scaffold",
        "implemented",
        "deprecated"
      ],
      "title": "ImplementationState",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/tool-package-spec/v0.1",
  "additionalProperties": false,
  "properties": {
    "card_ref": {
      "title": "Card Ref",
      "type": "string"
    },
    "environment_spec_id": {
      "title": "Environment Spec Id",
      "type": "string"
    },
    "implementation_state": {
      "$ref": "#/$defs/ImplementationState"
    },
    "input_schema_ref": {
      "title": "Input Schema Ref",
      "type": "string"
    },
    "method_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Method Ids",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "optional": {
      "default": false,
      "title": "Optional",
      "type": "boolean"
    },
    "output_schema_ref": {
      "title": "Output Schema Ref",
      "type": "string"
    },
    "scientific_status": {
      "title": "Scientific Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^P0-(0[1-9]|1[0-2])$",
      "title": "Tool Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "tool_id",
    "name",
    "version",
    "summary",
    "implementation_state",
    "scientific_status",
    "environment_spec_id",
    "input_schema_ref",
    "output_schema_ref",
    "method_ids",
    "card_ref"
  ],
  "title": "ToolPackageSpec",
  "type": "object"
}
