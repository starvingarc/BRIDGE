{
  "$defs": {
    "AssessmentState": {
      "enum": [
        "available",
        "not_assessed"
      ],
      "title": "AssessmentState",
      "type": "string"
    },
    "CoverageState": {
      "enum": [
        "complete",
        "partial",
        "not_assessed"
      ],
      "title": "CoverageState",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "ExclusionState": {
      "enum": [
        "observed",
        "cannot_exclude"
      ],
      "title": "ExclusionState",
      "type": "string"
    },
    "OODChannelVisualizationRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "channel_id": {
          "minLength": 1,
          "title": "Channel Id",
          "type": "string"
        },
        "channel_state": {
          "enum": [
            "supported",
            "unknown",
            "ood",
            "unavailable"
          ],
          "title": "Channel State",
          "type": "string"
        },
        "component_ref": {
          "const": "bridge.off-target-control.ood-source-agreement@0.1.0",
          "default": "bridge.off-target-control.ood-source-agreement@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "method_ref": {
          "minLength": 1,
          "title": "Method Ref",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "reason_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Id"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "reference_ref": {
          "minLength": 1,
          "title": "Reference Ref",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "source_family_id": {
          "minLength": 1,
          "title": "Source Family Id",
          "type": "string"
        },
        "upstream_result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Upstream Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "channel_id",
        "source_family_id",
        "channel_state",
        "method_ref",
        "reference_ref",
        "upstream_result_sha256",
        "evidence_ids",
        "evidence_state",
        "scientific_status",
        "missingness",
        "applicability"
      ],
      "title": "OODChannelVisualizationRecord",
      "type": "object"
    },
    "OODDecisionState": {
      "enum": [
        "supported",
        "unknown",
        "ood",
        "not_assessed"
      ],
      "title": "OODDecisionState",
      "type": "string"
    },
    "OODDisagreementRecord": {
      "additionalProperties": false,
      "properties": {
        "assessed_channel_count": {
          "title": "Assessed Channel Count",
          "type": "integer"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "disagreement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disagreement"
        },
        "distinct_source_family_count": {
          "title": "Distinct Source Family Count",
          "type": "integer"
        },
        "family_states": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Family States",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "assessed_channel_count",
        "distinct_source_family_count",
        "family_states",
        "disagreement",
        "assessment_state",
        "reason_codes"
      ],
      "title": "OODDisagreementRecord",
      "type": "object"
    },
    "OODEnsembleRecord": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "decision_state": {
          "$ref": "#/$defs/OODDecisionState"
        },
        "distinct_source_family_count": {
          "title": "Distinct Source Family Count",
          "type": "integer"
        },
        "family_vote_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Family Vote Counts",
          "type": "object"
        },
        "matched_reason_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched Reason Id"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "decision_state",
        "distinct_source_family_count",
        "family_vote_counts",
        "matched_reason_id",
        "assessment_state",
        "reason_codes"
      ],
      "title": "OODEnsembleRecord",
      "type": "object"
    },
    "OODFamilyVisualizationRecord": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assessed_channel_count": {
          "minimum": 0,
          "title": "Assessed Channel Count",
          "type": "integer"
        },
        "channel_count": {
          "exclusiveMinimum": 0,
          "title": "Channel Count",
          "type": "integer"
        },
        "channel_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Channel Ids",
          "type": "array"
        },
        "component_ref": {
          "const": "bridge.off-target-control.ood-source-agreement@0.1.0",
          "default": "bridge.off-target-control.ood-source-agreement@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "family_state": {
          "enum": [
            "supported",
            "unknown",
            "ood",
            "conflict",
            "unavailable"
          ],
          "title": "Family State",
          "type": "string"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "source_family_id": {
          "minLength": 1,
          "title": "Source Family Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "source_family_id",
        "family_state",
        "channel_count",
        "assessed_channel_count",
        "channel_ids",
        "evidence_ids",
        "evidence_state",
        "scientific_status",
        "missingness",
        "applicability"
      ],
      "title": "OODFamilyVisualizationRecord",
      "type": "object"
    },
    "ProductAccountingRecord": {
      "additionalProperties": false,
