      "required": [
        "record_id",
        "category",
        "display_name",
        "soft_mass",
        "observed_count",
        "denominator_soft_mass",
        "denominator_count",
        "denominator_scope",
        "unit",
        "coverage_state",
        "assessment_state",
        "exclusion_state",
        "soft_interval_state",
        "soft_interval_semantics",
        "count_interval_state",
        "count_interval_semantics",
        "evidence_ids",
        "evidence_state",
        "scientific_status",
        "missingness",
        "applicability"
      ],
      "title": "ProductAccountingRecord",
      "type": "object"
    },
