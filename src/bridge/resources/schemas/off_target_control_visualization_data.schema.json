          ],
          "default": null,
          "title": "Soft Interval Method Id"
        },
        "soft_interval_semantics": {
          "const": "independence_group_bootstrap_of_soft_assignment_mass",
          "title": "Soft Interval Semantics",
          "type": "string"
        },
        "soft_interval_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Soft Interval State",
          "type": "string"
        },
        "soft_interval_upper": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Soft Interval Upper"
        },
        "soft_mass": {
          "minimum": 0.0,
          "title": "Soft Mass",
          "type": "number"
        },
        "unit": {
          "const": "cells",
          "title": "Unit",
          "type": "string"
        }
