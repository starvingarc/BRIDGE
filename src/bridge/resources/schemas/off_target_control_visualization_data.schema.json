        "scientific_status": {
          "const": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "soft_interval_lower": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Soft Interval Lower"
        },
        "soft_interval_method_id": {
          "anyOf": [
            {
              "const": "COMP-HBOOT",
              "type": "string"
            },
            {
              "type": "null"
