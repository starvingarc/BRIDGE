{
  "$defs": {
    "ChannelAssessmentState": {
      "enum": [
        "complete",
        "partial",
        "not_assessed"
      ],
      "title": "ChannelAssessmentState",
      "type": "string"
    },
    "CompositionView": {
      "enum": [
        "consensus_supported_only",
        "source_specific"
      ],
      "title": "CompositionView",
      "type": "string"
    },
    "InputChecksumBindings": {
      "additionalProperties": false,
      "properties": {
        "annotation_vocabulary": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Annotation Vocabulary",
          "type": "string"
        },
        "biological_unit_assignment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Biological Unit Assignment",
          "type": "string"
        },
        "biological_unit_manifest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Biological Unit Manifest",
          "type": "string"
        },
        "cell_state_evidence_profile": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cell State Evidence Profile",
          "type": "string"
        },
        "measurement_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measurement Spec",
          "type": "string"
        },
        "product_case": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Case",
          "type": "string"
        },
        "product_definition_card": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Definition Card",
          "type": "string"
        },
        "qc_readiness_profile": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qc Readiness Profile",
          "type": "string"
        },
        "reference_manifest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Manifest",
          "type": "string"
        },
        "state_role_map": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Role Map",
          "type": "string"
        },
        "target_regional_assessment_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Regional Assessment Spec",
          "type": "string"
        },
        "target_regional_method_spec": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Regional Method Spec"
        }
      },
      "required": [
        "product_case",
        "product_definition_card",
        "state_role_map",
        "target_regional_assessment_spec",
        "measurement_spec",
        "cell_state_evidence_profile",
        "qc_readiness_profile",
        "biological_unit_manifest",
        "biological_unit_assignment",
        "annotation_vocabulary",
        "reference_manifest"
      ],
      "title": "InputChecksumBindings",
      "type": "object"
    },
    "MetricArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "composition_view": {
          "$ref": "#/$defs/CompositionView"
        },
        "file_name": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*\\.json$",
          "title": "File Name",
          "type": "string"
        },
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "measurement_id": {
          "minLength": 1,
          "title": "Measurement Id",
          "type": "string"
        },
        "metric_name": {
          "$ref": "#/$defs/NormalizedMetricName"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "measurement_id",
        "metric_name",
        "composition_view",
        "label_level",
        "artifact_id",
        "file_name",
        "sha256"
      ],
      "title": "MetricArtifactBinding",
      "type": "object"
    },
    "NormalizedMetricName": {
      "enum": [
        "target_identity_fraction",
        "regional_fidelity_fraction",
        "whole_product_target_region_fraction"
      ],
      "title": "NormalizedMetricName",
      "type": "string"
    },
    "RoleFraction": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "numerator",
        "denominator"
      ],
      "title": "RoleFraction",
      "type": "object"
    },
    "TargetRegionalChannelResult": {
      "additionalProperties": false,
      "properties": {
        "assessment_state": {
          "$ref": "#/$defs/ChannelAssessmentState"
        },
        "composition_view": {
          "$ref": "#/$defs/CompositionView"
        },
        "denominator_scope": {
          "const": "selected_data_view",
          "title": "Denominator Scope",
          "type": "string"
        },
        "label_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Label Level",
          "type": "string"
        },
        "measurement_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/NormalizedMetricName"
          },
          "title": "Measurement Ids",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array",
          "uniqueItems": true
        },
        "regional_fidelity_fraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleFraction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "target_identity_fraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleFraction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "whole_product_target_region_fraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleFraction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "composition_view",
        "label_level",
        "denominator_scope",
        "assessment_state",
        "measurement_ids"
      ],
      "title": "TargetRegionalChannelResult",
      "type": "object"
    },
    "TargetRegionalMethodArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "bundle_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "file_name": {
          "const": "target_regional_method_bundle.json",
          "title": "File Name",
          "type": "string"
        },
        "selected_method_ids": {
          "items": {
            "$ref": "#/$defs/TargetRegionalMethodId"
          },
          "minItems": 1,
          "title": "Selected Method Ids",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "bundle_ref",
        "file_name",
        "sha256",
        "selected_method_ids"
      ],
      "title": "TargetRegionalMethodArtifactBinding",
      "type": "object"
    },
    "TargetRegionalMethodId": {
      "enum": [
        "TRG-PBCORR",
        "REG-PBCORR",
        "TRG-NNLS",
        "TRG-DECOUPLER",
        "REG-DECOUPLER",
        "TRG-BOOTSTRAP",
        "REG-CROSSREF",
        "REG-MODALITY"
      ],
      "title": "TargetRegionalMethodId",
      "type": "string"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/target-regional-evidence-result/v0.2",
  "additionalProperties": false,
  "properties": {
    "annotation_vocabulary_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "assessment_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "biological_unit_manifest_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "cell_state_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/TargetRegionalChannelResult"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "input_sha256_by_role": {
      "$ref": "#/$defs/InputChecksumBindings"
    },
    "measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "method_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetRegionalMethodArtifactBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_artifacts": {
      "items": {
        "$ref": "#/$defs/MetricArtifactBinding"
      },
      "minItems": 3,
      "title": "Metric Artifacts",
      "type": "array"
    },
    "object_version": {
      "const": "0.2.0",
      "title": "Object Version",
      "type": "string"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "product_definition_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "qc_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array",
      "uniqueItems": true
    },
    "reference_manifest_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "result_id": {
      "pattern": "^target-regional-result:[a-f0-9]{16}$",
      "title": "Result Id",
      "type": "string"
    },
    "result_state": {
      "enum": [
        "complete",
        "partial",
        "not_assessed"
      ],
      "title": "Result State",
      "type": "string"
    },
    "score_state": {
      "enum": [
        "shadow",
        "unavailable"
      ],
      "title": "Score State",
      "type": "string"
    },
    "spatial_projection_state": {
      "const": "not_assessed",
      "title": "Spatial Projection State",
      "type": "string"
    },
    "state_role_map_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "tool_id": {
      "const": "P0-03",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Version",
      "type": "string"
    },
    "upstream_composition_state": {
      "enum": [
        "shadow",
        "not_assessed",
        "unavailable",
        "unknown",
        "missing"
      ],
      "title": "Upstream Composition State",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "result_id",
    "tool_id",
    "tool_version",
    "product_case_ref",
    "product_definition_ref",
    "state_role_map_ref",
    "assessment_spec_ref",
    "measurement_spec_ref",
    "cell_state_profile_ref",
    "qc_profile_ref",
    "biological_unit_manifest_ref",
    "annotation_vocabulary_ref",
    "reference_manifest_ref",
    "input_sha256_by_role",
    "upstream_composition_state",
    "result_state",
    "channels",
    "metric_artifacts",
    "spatial_projection_state",
    "evidence_refs",
    "reason_codes",
    "score_state"
  ],
  "title": "TargetRegionalEvidenceResult",
  "type": "object"
}
