{
  "$defs": {
    "EvidenceFamilySpec": {
      "additionalProperties": false,
      "properties": {
        "channel_role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Channel Role",
          "type": "string"
        },
        "evidence_family_id": {
          "pattern": "^evidence-family:[A-Za-z0-9._:-]+$",
          "title": "Evidence Family Id",
          "type": "string"
        },
        "family_type": {
          "$ref": "#/$defs/EvidenceFamilyType"
        },
        "independence_scope": {
          "minLength": 1,
          "title": "Independence Scope",
          "type": "string"
        },
        "known_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Known Dependencies",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reviewer_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Ref"
        },
        "shared_algorithm_refs": {
          "items": {
            "type": "string"
          },
          "title": "Shared Algorithm Refs",
          "type": "array"
        },
        "shared_reference_or_prior_refs": {
          "items": {
            "type": "string"
          },
          "title": "Shared Reference Or Prior Refs",
          "type": "array"
        },
        "shared_source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Shared Source Refs",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvidenceFamilyStatus"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_family_id",
        "version",
        "family_type",
        "channel_role",
        "independence_scope",
        "rationale",
        "status"
      ],
      "title": "EvidenceFamilySpec",
      "type": "object"
    },
    "EvidenceFamilyStatus": {
      "enum": [
        "reviewed",
        "unreviewed",
        "retired"
      ],
      "title": "EvidenceFamilyStatus",
      "type": "string"
    },
    "EvidenceFamilyType": {
      "enum": [
        "shared_data",
        "shared_algorithm",
        "shared_reference",
        "shared_prior",
        "shared_knowledge",
        "shared_aggregation"
      ],
      "title": "EvidenceFamilyType",
      "type": "string"
    },
    "RegistryStatus": {
      "enum": [
        "candidate",
        "frozen",
        "retired"
      ],
      "title": "RegistryStatus",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/evidence-family-registry/v0.1",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "families": {
      "items": {
        "$ref": "#/$defs/EvidenceFamilySpec"
      },
      "minItems": 1,
      "title": "Families",
      "type": "array"
    },
    "registry_id": {
      "const": "BRIDGE-EVIDENCE-FAMILY-REGISTRY-v0.1",
      "title": "Registry Id",
      "type": "string"
    },
    "registry_version": {
      "const": "0.1.0",
      "title": "Registry Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RegistryStatus"
    }
  },
  "required": [
    "registry_id",
    "registry_version",
    "status",
    "created_at",
    "families"
  ],
  "title": "EvidenceFamilyRegistry",
  "type": "object"
}
