{
  "$defs": {
    "CellStateResolutionRecord": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fraction",
          "type": "number"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "resolution_state": {
          "enum": [
            "supported",
            "unknown",
            "ood",
            "unresolved",
            "unavailable"
          ],
          "title": "Resolution State",
          "type": "string"
        },
        "unit": {
          "const": "observations",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "resolution_state",
        "display_name",
        "count",
        "denominator",
        "fraction",
        "unit",
        "evidence_ids"
      ],
      "title": "CellStateResolutionRecord",
      "type": "object"
    },
    "DevelopmentStageCompositionRecord": {
      "additionalProperties": false,
