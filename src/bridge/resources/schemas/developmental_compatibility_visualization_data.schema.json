            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "output_semantics": {
          "const": "uncalibrated_similarity_not_age_or_probability",
