        "scientific_status": {
          "const": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "shared_genes": {
          "minimum": 0,
          "title": "Shared Genes",
          "type": "integer"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "top_cosine_support": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
