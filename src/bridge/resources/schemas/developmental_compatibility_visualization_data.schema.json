            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Development Method Spec"
        },
        "development_state_map": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Development State Map",
          "type": "string"
        },
        "development_timepoint_series": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Development Timepoint Series"
        },
        "development_window_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Development Window Spec",
          "type": "string"
        },
        "measurement_spec": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measurement Spec",
          "type": "string"
        },
        "product_case": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Case",
          "type": "string"
        },
        "product_definition_card": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Product Definition Card",
          "type": "string"
        },
        "qc_readiness_profile": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qc Readiness Profile"
        },
        "reference_manifest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Manifest"
        }
      },
      "required": [
        "product_case",
        "product_definition_card",
        "development_window_spec",
        "development_state_map",
        "measurement_spec",
        "cell_state_evidence_profile"
      ],
      "title": "InputChecksumBindings",
      "type": "object"
    },
    "ObservedSamplingPointRecord": {
