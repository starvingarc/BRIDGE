          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "margin": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
