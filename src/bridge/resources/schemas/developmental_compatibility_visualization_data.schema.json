          "const": "bridge.developmental-compatibility.window-composition@0.1.0",
          "default": "bridge.developmental-compatibility.window-composition@0.1.0",
          "title": "Component Ref",
          "type": "string"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "denominator_kind": {
          "enum": [
            "whole_product",
            "target_related"
          ],
          "title": "Denominator Kind",
          "type": "string"
        },
        "denominator_label": {
          "minLength": 1,
          "title": "Denominator Label",
          "type": "string"
        },
        "denominator_scope": {
          "enum": [
            "evaluated_product",
            "target_related_subset"
          ],
          "title": "Denominator Scope",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction"
        },
        "interval_lower": {
          "default": null,
          "title": "Interval Lower",
          "type": "null"
        },
        "interval_state": {
          "const": "not_estimable",
          "title": "Interval State",
          "type": "string"
        },
        "interval_upper": {
          "default": null,
          "title": "Interval Upper",
          "type": "null"
        },
        "missingness": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Missingness",
          "type": "string"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[a-z][a-z0-9_.-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "scientific_status": {
          "const": "candidate",
          "title": "Scientific Status",
          "type": "string"
        },
        "stage_role": {
          "$ref": "#/$defs/DevelopmentStageRole"
        },
        "unit": {
          "const": "observations",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "denominator_kind",
        "denominator_label",
        "stage_role",
        "axis_group",
        "display_name",
        "numerator",
        "denominator",
        "denominator_scope",
        "unit",
        "interval_state",
        "evidence_ids",
        "evidence_state",
        "scientific_status",
        "missingness",
        "applicability"
      ],
      "title": "DevelopmentStageCompositionRecord",
      "type": "object"
    },
    "DevelopmentStageRole": {
      "enum": [
        "earlier",
        "within_window",
        "later",
        "branch_shift",
        "unresolved"
      ],
      "title": "DevelopmentStageRole",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "InputChecksumBindings": {
      "additionalProperties": false,
      "properties": {
        "annotation_vocabulary": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
