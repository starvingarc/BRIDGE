  "$id": "bridge://schemas/developmental-compatibility-visualization-data/v0.1",
  "additionalProperties": false,
  "properties": {
    "analysis_mode": {
      "enum": [
        "static_profile",
        "descriptive_timecourse"
      ],
      "title": "Analysis Mode",
      "type": "string"
    },
    "cell_state_profile_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "continuous_time_reason_code": {
      "const": "numeric_time_axis_not_bound",
      "title": "Continuous Time Reason Code",
      "type": "string"
    },
    "continuous_time_state": {
      "const": "not_assessed",
      "title": "Continuous Time State",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "input_sha256_by_role": {
      "$ref": "#/$defs/InputChecksumBindings"
    },
    "measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "method_bundle_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "method_bundle_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Bundle Sha256"
    },
    "method_spec_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "object_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "producer_run_ref": {
      "pattern": "^run:run-[a-f0-9]{16}$",
      "title": "Producer Run Ref",
      "type": "string"
    },
    "producer_tool_version": {
      "minLength": 1,
      "title": "Producer Tool Version",
      "type": "string"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "product_definition_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "profile_id": {
      "pattern": "^developmental-compatibility-visualization-data:[a-f0-9]{16}$",
      "title": "Profile Id",
      "type": "string"
    },
    "reference_manifest_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_records": {
      "items": {
        "$ref": "#/$defs/ReferenceStageSimilarityRecord"
      },
      "title": "Reference Records",
      "type": "array"
    },
    "reference_support_applicability": {
      "enum": [
        "applicable",
        "partially_applicable",
        "not_assessed"
