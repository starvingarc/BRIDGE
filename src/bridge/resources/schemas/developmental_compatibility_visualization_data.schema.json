          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "not_assessed"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "assay": {
          "minLength": 1,
          "title": "Assay",
          "type": "string"
        },
        "component_ref": {
          "const": "bridge.developmental-compatibility.reference-stage-summary@0.1.0",
          "default": "bridge.developmental-compatibility.reference-stage-summary@0.1.0",
