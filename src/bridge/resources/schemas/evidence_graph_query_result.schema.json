{
  "$id": "bridge://schemas/evidence-graph-query-result/v0.1",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "graph_version": {
      "title": "Graph Version",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Nodes",
      "type": "array"
    },
    "omitted_edge_count": {
      "minimum": 0,
      "title": "Omitted Edge Count",
      "type": "integer"
    },
    "omitted_node_count": {
      "minimum": 0,
      "title": "Omitted Node Count",
      "type": "integer"
    },
    "query_name": {
      "enum": [
        "get_claim_evidence",
        "trace_evidence_provenance",
        "get_conflicting_evidence",
        "get_missing_requirements",
        "get_evidence_family_members",
        "get_case_evidence_subgraph",
        "compare_evidence_paths"
      ],
      "title": "Query Name",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "returned_edge_count": {
      "minimum": 0,
      "title": "Returned Edge Count",
      "type": "integer"
    },
    "returned_node_count": {
      "minimum": 0,
      "title": "Returned Node Count",
      "type": "integer"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "query_name",
    "graph_id",
    "graph_version",
    "nodes",
    "edges",
    "returned_node_count",
    "returned_edge_count",
    "truncated",
    "omitted_node_count",
    "omitted_edge_count",
    "reason_codes"
  ],
  "title": "EvidenceGraphQueryResult",
  "type": "object"
}
