{
  "$defs": {
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/product-case/v0.1",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "biological_unit_manifest_ref": {
          "type": "null"
        },
        "biological_unit_manifest_sha256": {
          "type": "null"
        },
        "independence_group_refs": {
          "maxItems": 0
        },
        "independence_scope_ref": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "biological_unit_manifest_ref": {
          "not": {
            "type": "null"
          }
        },
        "biological_unit_manifest_sha256": {
          "not": {
            "type": "null"
          }
        },
        "independence_scope_ref": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "biological_unit_manifest_ref",
        "biological_unit_manifest_sha256",
        "independence_scope_ref"
      ]
    }
  ],
  "properties": {
    "assay": {
      "enum": [
        "scRNA-seq",
        "snRNA-seq"
      ],
      "title": "Assay",
      "type": "string"
    },
    "biological_unit_manifest_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "biological_unit_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Biological Unit Manifest Sha256"
    },
    "case_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Case Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "independence_group_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "title": "Independence Group Refs",
      "type": "array"
    },
    "independence_scope_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "product_case_id": {
      "pattern": "^product-case:[A-Za-z0-9._:-]+$",
      "title": "Product Case Id",
      "type": "string"
    },
    "product_definition_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "provenance_refs": {
      "items": {
        "$ref": "#/$defs/VersionedObjectRef"
      },
      "minItems": 1,
      "title": "Provenance Refs",
      "type": "array"
    },
    "sample_or_preparation_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "source_unit_kind": {
      "enum": [
        "sample",
        "preparation"
      ],
      "title": "Source Unit Kind",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "product_case_id",
    "case_version",
    "product_definition_ref",
    "source_unit_kind",
    "sample_or_preparation_ref",
    "measurement_spec_ref",
    "assay",
    "provenance_refs",
    "created_at"
  ],
  "title": "ProductCase",
  "type": "object"
}
