{
  "$defs": {
    "EvidenceState": {
      "enum": [
        "measured",
        "inferred",
        "prior_only",
        "negative",
        "missing",
        "unknown",
        "unavailable",
        "alert"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "GraftChannelRule": {
      "additionalProperties": false,
      "properties": {
        "animal_estimand": {
          "const": "mean_of_independent_animal_values",
          "title": "Animal Estimand",
          "type": "string"
        },
        "channel_id": {
          "pattern": "^graft-channel:[A-Za-z0-9._:-]+$",
          "title": "Channel Id",
          "type": "string"
        },
        "cross_stratum_aggregation": {
          "const": "forbidden",
          "title": "Cross Stratum Aggregation",
          "type": "string"
        },
        "denominator_semantics": {
          "enum": [
            "not_applicable",
            "observation_denominator",
            "pooled_denominator"
          ],
          "title": "Denominator Semantics",
          "type": "string"
        },
        "eligible_evidence_states": {
          "items": {
            "$ref": "#/$defs/EvidenceState"
          },
          "minItems": 1,
          "title": "Eligible Evidence States",
          "type": "array",
          "uniqueItems": true
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "strata": {
          "items": {
            "$ref": "#/$defs/GraftStratumRule"
          },
          "minItems": 1,
          "title": "Strata",
          "type": "array"
        },
        "unit": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "within_animal_aggregation": {
          "$ref": "#/$defs/WithinAnimalAggregation"
        }
      },
      "required": [
        "channel_id",
        "unit",
        "required",
        "eligible_evidence_states",
        "animal_estimand",
        "within_animal_aggregation",
        "denominator_semantics",
        "cross_stratum_aggregation",
        "strata"
      ],
      "title": "GraftChannelRule",
      "type": "object"
    },
    "GraftStratumMember": {
      "additionalProperties": false,
      "properties": {
        "graft_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        },
        "timepoint_ref": {
          "$ref": "#/$defs/VersionedObjectRef"
        }
      },
      "required": [
        "graft_ref",
        "timepoint_ref"
      ],
      "title": "GraftStratumMember",
      "type": "object"
    },
    "GraftStratumRule": {
      "additionalProperties": false,
      "properties": {
        "configured_lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Lower Bound"
        },
        "configured_upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Upper Bound"
        },
        "interpretation_policy": {
          "enum": [
            "descriptive_only",
            "configured_interval"
          ],
          "title": "Interpretation Policy",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/GraftStratumMember"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "minimum_independent_animals": {
          "exclusiveMinimum": 0,
          "title": "Minimum Independent Animals",
          "type": "integer"
        },
        "stratum_id": {
          "pattern": "^graft-stratum:[A-Za-z0-9._:-]+$",
          "title": "Stratum Id",
          "type": "string"
        }
      },
      "required": [
        "stratum_id",
        "members",
        "minimum_independent_animals",
        "interpretation_policy"
      ],
      "title": "GraftStratumRule",
      "type": "object"
    },
    "VersionedObjectRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "object_version"
      ],
      "title": "VersionedObjectRef",
      "type": "object"
    },
    "WithinAnimalAggregation": {
      "enum": [
        "single_observation",
        "arithmetic_mean",
        "pooled_numerator_denominator"
      ],
      "title": "WithinAnimalAggregation",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/graft-assessment-spec/v0.1",
  "additionalProperties": false,
  "properties": {
    "algorithm_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "allowed_graft_analysis_unit_kinds": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Graft Analysis Unit Kinds",
      "type": "array"
    },
    "allowed_graft_assays": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Graft Assays",
      "type": "array"
    },
    "assay_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "assessment_spec_id": {
      "pattern": "^graft-assessment-spec:[A-Za-z0-9._:-]+$",
      "title": "Assessment Spec Id",
      "type": "string"
    },
    "assessment_spec_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Assessment Spec Version",
      "type": "string"
    },
    "confounded_design_policy": {
      "const": "descriptive_only",
      "title": "Confounded Design Policy",
      "type": "string"
    },
    "graft_measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "missing_observation_policy": {
      "const": "report_unavailable",
      "title": "Missing Observation Policy",
      "type": "string"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "preparation_linkage_policy": {
      "const": "explicit_evidence_only",
      "title": "Preparation Linkage Policy",
      "type": "string"
    },
    "product_case_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "product_measurement_spec_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "reference_snapshot_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "required_graft_context": {
      "minLength": 1,
      "title": "Required Graft Context",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/GraftChannelRule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "sampling_context_ref": {
      "$ref": "#/$defs/VersionedObjectRef"
    },
    "score_policy": {
      "const": "unavailable",
      "title": "Score Policy",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "assessment_spec_id",
    "assessment_spec_version",
    "product_case_ref",
    "product_measurement_spec_ref",
    "graft_measurement_spec_ref",
    "allowed_graft_assays",
    "allowed_graft_analysis_unit_kinds",
    "required_graft_context",
    "assay_ref",
    "sampling_context_ref",
    "reference_snapshot_ref",
    "algorithm_ref",
    "rules",
    "missing_observation_policy",
    "confounded_design_policy",
    "preparation_linkage_policy",
    "score_policy"
  ],
  "title": "GraftAssessmentSpec",
  "type": "object"
}
