  "$id": "bridge://schemas/claim-verifier-visualization-data/v0.1",
  "additionalProperties": false,
  "properties": {
    "binding_count": {
      "minimum": 0,
      "title": "Binding Count",
      "type": "integer"
    },
    "check_counts_are_audit_counts_not_evidence_amount": {
      "const": true,
      "default": true,
      "title": "Check Counts Are Audit Counts Not Evidence Amount",
      "type": "boolean"
    },
    "check_matrix_records": {
      "items": {
        "discriminator": {
          "mapping": {
            "claim_check_matrix": "#/$defs/ClaimCheckMatrixRecord",
            "report_check_matrix": "#/$defs/ReportCheckMatrixRecord"
          },
          "propertyName": "record_kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ReportCheckMatrixRecord"
          },
          {
            "$ref": "#/$defs/ClaimCheckMatrixRecord"
          }
        ]
      },
      "minItems": 2,
      "title": "Check Matrix Records",
      "type": "array"
    },
    "claim_count": {
      "minimum": 1,
      "title": "Claim Count",
      "type": "integer"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_count": {
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "finding_records": {
      "items": {
        "discriminator": {
