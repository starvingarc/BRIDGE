{
  "$defs": {
    "DataViewBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "biological_unit_manifest_ref": {
                  "type": "null"
                },
                "biological_unit_manifest_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "biological_unit_manifest_ref": {
                  "not": {
                    "type": "null"
                  }
                },
                "biological_unit_manifest_sha256": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "biological_unit_manifest_ref",
                "biological_unit_manifest_sha256"
              ]
            }
          ]
        }
      ],
      "description": "Content-addressed expression view passed between scientific tools.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "biological_unit_manifest_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Ref"
        },
        "biological_unit_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biological Unit Manifest Sha256"
        },
        "matrix_location": {
          "minLength": 1,
          "title": "Matrix Location",
          "type": "string"
        },
        "matrix_semantics": {
          "enum": [
            "raw_counts",
            "normalized_expression"
          ],
          "title": "Matrix Semantics",
          "type": "string"
        },
        "n_observations": {
          "minimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observation_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Ids Sha256",
          "type": "string"
        },
        "parent_asset_id": {
          "minLength": 1,
          "title": "Parent Asset Id",
          "type": "string"
        },
        "parent_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Asset Sha256",
          "type": "string"
        },
        "sample_or_preparation_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Or Preparation Ref"
        },
        "selection_spec_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Spec Ref"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "view_id": {
          "minLength": 1,
          "title": "View Id",
          "type": "string"
        },
        "view_kind": {
          "enum": [
            "all_observations",
            "qc_selected_observations"
          ],
          "title": "View Kind",
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "view_kind",
        "artifact_id",
        "sha256",
        "parent_asset_id",
        "parent_asset_sha256",
        "matrix_location",
        "matrix_semantics",
        "n_observations",
        "observation_ids_sha256"
      ],
      "title": "DataViewBinding",
      "type": "object"
    },
    "DirectedProgramInput": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_view": {
          "$ref": "#/$defs/DataViewBinding"
        },
        "gene_coverage_policy": {
          "enum": [
            "complete_only",
            "observed_subset"
          ],
          "title": "Gene Coverage Policy",
          "type": "string"
        },
        "gene_symbol_column": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene Symbol Column"
        },
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Input Id",
          "type": "string"
        },
        "object_version": {
          "const": "0.3.0",
          "title": "Object Version",
          "type": "string"
        },
        "programs": {
          "items": {
            "$ref": "#/$defs/DirectedProgramSelection"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Programs",
          "type": "array"
        },
        "resource": {
          "$ref": "#/$defs/DirectedResourceBinding"
        },
        "source_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Family Id",
          "type": "string"
        }
      },
      "required": [
        "object_version",
        "input_id",
        "source_family_id",
        "data_view",
        "resource",
        "programs",
        "gene_coverage_policy",
        "created_at"
      ],
      "title": "DirectedProgramInput",
      "type": "object"
    },
    "DirectedProgramSelection": {
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Program Id",
          "type": "string"
        },
        "source_gene_set": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Gene Set",
          "type": "string"
        }
      },
      "required": [
        "program_id",
        "source_gene_set"
      ],
      "title": "DirectedProgramSelection",
      "type": "object"
    },
    "DirectedProgramSummary": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_genes": {
          "items": {
            "type": "string"
          },
          "title": "Ambiguous Genes",
          "type": "array"
        },
        "assessment_state": {
          "enum": [
            "available",
            "not_assessed"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "declared_gene_count": {
          "exclusiveMinimum": 0,
          "title": "Declared Gene Count",
          "type": "integer"
        },
        "direction_definition": {
          "enum": [
            "candidate_membership_plus_one",
            "sign_of_source_logFC"
          ],
          "title": "Direction Definition",
          "type": "string"
        },
        "gene_coverage_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gene Coverage Fraction",
          "type": "number"
        },
        "gene_symbols_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gene Symbols Sha256",
          "type": "string"
        },
        "lower_quantile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Quantile"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "method_id": {
          "enum": [
            "PROC-SCORE-SCANPY",
            "PROC-SCORE-DECOUPLER"
          ],
          "title": "Method Id",
          "type": "string"
        },
        "missing_genes": {
          "items": {
            "type": "string"
          },
          "title": "Missing Genes",
          "type": "array"
        },
        "n_observations": {
          "exclusiveMinimum": 0,
          "title": "N Observations",
          "type": "integer"
        },
        "observed_gene_count": {
          "minimum": 0,
          "title": "Observed Gene Count",
          "type": "integer"
        },
        "observed_gene_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Observed Gene Symbols",
          "type": "array"
        },
        "program_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Program Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "score_unit": {
          "enum": [
            "scanpy_control_adjusted_expression",
            "decoupler_ulm_t_value"
          ],
          "title": "Score Unit",
          "type": "string"
        },
        "scored_targets": {
          "items": {
            "$ref": "#/$defs/ScoredProgramTarget"
          },
          "title": "Scored Targets",
          "type": "array"
        },
        "scored_targets_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scored Targets Sha256",
          "type": "string"
        },
        "signature_scope": {
          "enum": [
            "complete",
            "observed_feature_subset",
            "not_estimable"
          ],
          "title": "Signature Scope",
          "type": "string"
        },
        "source_gene_set": {
          "title": "Source Gene Set",
          "type": "string"
        },
        "source_members": {
          "items": {
            "$ref": "#/$defs/SourceProgramMember"
          },
          "title": "Source Members",
          "type": "array"
        },
        "unresolved_members": {
          "items": {
            "$ref": "#/$defs/SourceProgramMember"
          },
          "title": "Unresolved Members",
          "type": "array"
        },
        "upper_quantile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Quantile"
        }
      },
      "required": [
        "program_id",
        "method_id",
        "score_unit",
        "n_observations",
        "observed_gene_count",
        "declared_gene_count",
        "missing_genes",
        "assessment_state",
        "reason_codes",
        "source_gene_set",
        "gene_symbols_sha256",
        "observed_gene_symbols",
        "gene_coverage_fraction",
        "signature_scope",
        "source_members",
        "unresolved_members",
        "scored_targets",
        "scored_targets_sha256",
        "direction_definition"
      ],
      "title": "DirectedProgramSummary",
      "type": "object"
    },
    "DirectedResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "hu_pluripotency_csv",
            "oflanagan_core_csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "license_ref": {
          "minLength": 1,
          "title": "License Ref",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "resource_ref": {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*(?::[^\\s]+)?$",
          "title": "Resource Ref",
          "type": "string"
        },
        "resource_version": {
          "minLength": 1,
          "title": "Resource Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Family Id",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://\\S+$",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "resource_ref",
        "resource_version",
        "source_family_id",
        "path",
        "sha256",
        "source_url",
        "license_ref",
        "format"
      ],
      "title": "DirectedResourceBinding",
      "type": "object"
    },
    "MethodExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "execution_state": {
          "$ref": "#/$defs/MethodExecutionState"
        },
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "method_id": {
          "$ref": "#/$defs/ProcessMethodId"
        },
        "method_ref": {
          "pattern": "^METHOD-[A-Z0-9-]+$",
          "title": "Method Ref",
          "type": "string"
        },
        "package_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Package Versions",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "method_id",
        "method_ref",
        "implementation",
        "execution_state",
        "package_versions",
        "reason_codes"
      ],
      "title": "MethodExecutionRecord",
      "type": "object"
    },
    "MethodExecutionState": {
      "enum": [
        "succeeded",
        "partial",
        "not_assessed"
      ],
      "title": "MethodExecutionState",
      "type": "string"
    },
    "ProcessMethodId": {
      "enum": [
        "PROC-SCORE-SCANPY",
        "PROC-SCORE-DECOUPLER",
        "PROC-CYCLE-SCANPY",
        "PROC-CYCLE-AGG"
      ],
      "title": "ProcessMethodId",
      "type": "string"
    },
    "ProgramParameters": {
      "additionalProperties": false,
      "properties": {
        "decoupler_empty": {
          "const": false,
          "default": false,
          "title": "Decoupler Empty",
          "type": "boolean"
        },
        "decoupler_tmin": {
          "const": 5,
          "default": 5,
          "title": "Decoupler Tmin",
          "type": "integer"
        },
        "layer": {
          "default": null,
          "title": "Layer",
          "type": "null"
        },
        "lower_quantile": {
          "const": 0.1,
          "default": 0.1,
          "title": "Lower Quantile",
          "type": "number"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "scanpy_ctrl_as_ref": {
          "const": true,
          "default": true,
          "title": "Scanpy Ctrl As Ref",
          "type": "boolean"
        },
        "scanpy_ctrl_size": {
          "const": 50,
          "default": 50,
          "title": "Scanpy Ctrl Size",
          "type": "integer"
        },
        "scanpy_n_bins": {
          "const": 25,
          "default": 25,
          "title": "Scanpy N Bins",
          "type": "integer"
        },
        "upper_quantile": {
          "const": 0.9,
          "default": 0.9,
          "title": "Upper Quantile",
          "type": "number"
        },
        "use_raw": {
          "const": false,
          "default": false,
          "title": "Use Raw",
          "type": "boolean"
        }
      },
      "required": [
        "random_seed"
      ],
      "title": "ProgramParameters",
      "type": "object"
    },
    "ScoredProgramTarget": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            -1,
            1
          ],
          "title": "Direction",
          "type": "integer"
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "gene_symbol": {
          "title": "Gene Symbol",
          "type": "string"
        },
        "source_member_id": {
          "title": "Source Member Id",
          "type": "string"
        }
      },
      "required": [
        "source_member_id",
        "gene_symbol",
        "feature_id",
        "direction"
      ],
      "title": "ScoredProgramTarget",
      "type": "object"
    },
    "SourceProgramMember": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            -1,
            1
          ],
          "title": "Direction",
          "type": "integer"
        },
        "gene_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gene Symbol"
        },
        "source_member_id": {
          "minLength": 1,
          "title": "Source Member Id",
          "type": "string"
        },
        "unresolved_reason": {
          "anyOf": [
            {
              "const": "source_gene_symbol_missing",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Reason"
        }
      },
      "required": [
        "source_member_id",
        "gene_symbol",
        "direction"
      ],
      "title": "SourceProgramMember",
      "type": "object"
    }
  },
  "$id": "bridge://schemas/exploratory-program-profile/v0.2",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "domain_score": {
      "default": null,
      "title": "Domain Score",
      "type": "null"
    },
    "evidence_family_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evidence Family Id",
      "type": "string"
    },
    "executions": {
      "items": {
        "$ref": "#/$defs/MethodExecutionRecord"
      },
      "title": "Executions",
      "type": "array"
    },
    "expression_asset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expression Asset Sha256",
      "type": "string"
    },
    "independence_state": {
      "const": "unknown",
      "default": "unknown",
      "title": "Independence State",
      "type": "string"
    },
    "input_contract": {
      "$ref": "#/$defs/DirectedProgramInput"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "interpretation_scope": {
      "const": "descriptive_only",
      "default": "descriptive_only",
      "title": "Interpretation Scope",
      "type": "string"
    },
    "limitations": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "method_parameters": {
      "$ref": "#/$defs/ProgramParameters"
    },
    "n_features": {
      "exclusiveMinimum": 0,
      "title": "N Features",
      "type": "integer"
    },
    "n_independent_replicates": {
      "default": null,
      "title": "N Independent Replicates",
      "type": "null"
    },
    "n_observations": {
      "exclusiveMinimum": 0,
      "title": "N Observations",
      "type": "integer"
    },
    "normalization_recipe": {
      "enum": [
        "normalize_total_10000_log1p",
        "declared_normalized_expression"
      ],
      "title": "Normalization Recipe",
      "type": "string"
    },
    "object_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Object Version",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Profile Id",
      "type": "string"
    },
    "program_summaries": {
      "items": {
        "$ref": "#/$defs/DirectedProgramSummary"
      },
      "title": "Program Summaries",
      "type": "array"
    },
    "runtime_mode": {
      "const": "exploratory_programs",
      "default": "exploratory_programs",
      "title": "Runtime Mode",
      "type": "string"
    },
    "score_state": {
      "const": "unavailable",
      "default": "unavailable",
      "title": "Score State",
      "type": "string"
    },
    "target_feature_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Target Feature Ids",
      "type": "object"
    },
    "tool_id": {
      "const": "P0-06",
      "default": "P0-06",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "tool_version",
    "input_sha256",
    "expression_asset_sha256",
    "input_contract",
    "method_parameters",
    "normalization_recipe",
    "evidence_family_id",
    "n_observations",
    "n_features",
    "target_feature_ids",
    "executions",
    "program_summaries",
    "limitations",
    "created_at"
  ],
  "title": "DirectedProgramProfile",
  "type": "object"
}
