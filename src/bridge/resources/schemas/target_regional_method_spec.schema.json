{
  "$defs": {
    "TargetRegionalMethodId": {
      "enum": [
        "TRG-PBCORR",
        "REG-PBCORR",
        "TRG-NNLS",
        "TRG-DECOUPLER",
        "REG-DECOUPLER",
        "TRG-BOOTSTRAP",
        "REG-CROSSREF",
        "REG-MODALITY"
      ],
      "title": "TargetRegionalMethodId",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/target-regional-method-spec/v0.1",
  "additionalProperties": false,
  "description": "External, versioned choices for optional expression-level evidence.",
  "properties": {
    "bootstrap_confidence_level": {
      "default": 0.95,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Bootstrap Confidence Level",
      "type": "number"
    },
    "bootstrap_replicates": {
      "default": 1000,
      "maximum": 10000,
      "minimum": 10,
      "title": "Bootstrap Replicates",
      "type": "integer"
    },
    "expression_asset_id": {
      "minLength": 1,
      "title": "Expression Asset Id",
      "type": "string"
    },
    "gene_symbol_column": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gene Symbol Column"
    },
    "method_spec_id": {
      "pattern": "^target-regional-method-spec:[A-Za-z0-9._:-]+$",
      "title": "Method Spec Id",
      "type": "string"
    },
    "method_spec_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Method Spec Version",
      "type": "string"
    },
    "minimum_program_genes": {
      "minimum": 2,
      "title": "Minimum Program Genes",
      "type": "integer"
    },
    "minimum_shared_genes": {
      "minimum": 2,
      "title": "Minimum Shared Genes",
      "type": "integer"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "observation_id_column": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Id Column"
    },
    "regional_program_card_ids": {
      "items": {
        "type": "string"
      },
      "title": "Regional Program Card Ids",
      "type": "array"
    },
    "regional_reference_profile_ids": {
      "items": {
        "type": "string"
      },
      "title": "Regional Reference Profile Ids",
      "type": "array"
    },
    "selected_method_ids": {
      "items": {
        "$ref": "#/$defs/TargetRegionalMethodId"
      },
      "minItems": 1,
      "title": "Selected Method Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "candidate",
        "frozen"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_program_card_ids": {
      "items": {
        "type": "string"
      },
      "title": "Target Program Card Ids",
      "type": "array"
    },
    "target_reference_profile_ids": {
      "items": {
        "type": "string"
      },
      "title": "Target Reference Profile Ids",
      "type": "array"
    }
  },
  "required": [
    "object_version",
    "method_spec_id",
    "method_spec_version",
    "status",
    "expression_asset_id",
    "selected_method_ids",
    "minimum_shared_genes",
    "minimum_program_genes"
  ],
  "title": "TargetRegionalMethodSpec",
  "type": "object"
}
