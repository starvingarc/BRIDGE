{
  "$defs": {
    "CheckOutcome": {
      "enum": [
        "blocked",
        "review_required",
        "warning",
        "cleared_by_review"
      ],
      "title": "CheckOutcome",
      "type": "string"
    },
    "CheckSeverity": {
      "enum": [
        "hard_blocker",
        "review",
        "warning"
      ],
      "title": "CheckSeverity",
      "type": "string"
    },
    "ClaimCheckRecord": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^check:[a-f0-9]{16}$",
          "title": "Check Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "human_review_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Review Ref"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/CheckSeverity"
        },
        "text_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Span"
        }
      },
      "required": [
        "check_id",
        "claim_id",
        "rule_id",
        "rule_version",
        "outcome",
        "severity",
        "reason_code",
        "detail"
      ],
      "title": "ClaimCheckRecord",
      "type": "object"
    },
    "PublicExportEligibility": {
      "enum": [
        "eligible",
        "ineligible",
        "not_assessed"
      ],
      "title": "PublicExportEligibility",
      "type": "string"
    },
    "ReleaseState": {
      "enum": [
        "not_assessed",
        "release_blocked",
        "review_required",
        "verified_with_warnings",
        "verified"
      ],
      "title": "ReleaseState",
      "type": "string"
    }
  },
  "$id": "bridge://schemas/claim-verification-result/v0.1",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "release_state": {
            "const": "not_assessed"
          }
        },
        "required": [
          "release_state"
        ]
      },
      "then": {
        "properties": {
          "check_records": {
            "maxItems": 0
          },
          "public_export_eligibility": {
            "const": "not_assessed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_state": {
            "const": "release_blocked"
          }
        },
        "required": [
          "release_state"
        ]
      },
      "then": {
        "properties": {
          "check_records": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "blocked"
                }
              },
              "required": [
                "outcome"
              ]
            }
          },
          "public_export_eligibility": {
            "const": "ineligible"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_state": {
            "const": "review_required"
          }
        },
        "required": [
          "release_state"
        ]
      },
      "then": {
        "properties": {
          "check_records": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "review_required"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "not": {
              "contains": {
                "properties": {
                  "outcome": {
                    "const": "blocked"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "public_export_eligibility": {
            "const": "ineligible"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_state": {
            "const": "verified_with_warnings"
          }
        },
        "required": [
          "release_state"
        ]
      },
      "then": {
        "properties": {
          "check_records": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "warning"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "not": {
              "contains": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "blocked",
                      "review_required"
                    ]
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "public_export_eligibility": {
            "enum": [
              "eligible",
              "ineligible"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_state": {
            "const": "verified"
          }
        },
        "required": [
          "release_state"
        ]
      },
      "then": {
        "properties": {
          "check_records": {
            "not": {
              "contains": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "blocked",
                      "review_required",
                      "warning"
                    ]
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "public_export_eligibility": {
            "enum": [
              "eligible",
              "ineligible"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "benchmark_id": {
      "const": "P0-10-BENCHMARK-v0.1",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_sha256": {
      "const": "bb25a8d4a272f051e2918fd18999d7bbe424259258c3353dbc258f528f0edc26",
      "title": "Benchmark Sha256",
      "type": "string"
    },
    "check_records": {
      "items": {
        "$ref": "#/$defs/ClaimCheckRecord"
      },
      "title": "Check Records",
      "type": "array"
    },
    "claim_evidence_map": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Claim Evidence Map",
      "type": "object"
    },
    "claim_policy_ref": {
      "const": "claim-policy:p0-10-public@0.1.0",
      "title": "Claim Policy Ref",
      "type": "string"
    },
    "object_version": {
      "const": "0.1.0",
      "title": "Object Version",
      "type": "string"
    },
    "public_export_eligibility": {
      "$ref": "#/$defs/PublicExportEligibility"
    },
    "release_contract_id": {
      "const": "P0-10-RELEASE-CONTRACT-v0.1",
      "title": "Release Contract Id",
      "type": "string"
    },
    "release_contract_sha256": {
      "const": "3e881633eb281f7c3bf897c578596bf5629061a755854b0fdec71b0cd6b51f5f",
      "title": "Release Contract Sha256",
      "type": "string"
    },
    "release_state": {
      "$ref": "#/$defs/ReleaseState"
    },
    "report_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Content Hash",
      "type": "string"
    },
    "report_draft_ref": {
      "title": "Report Draft Ref",
      "type": "string"
    },
    "statement_registry_ref": {
      "const": "BRIDGE-STATEMENT-REGISTRY-v0.1@0.1.0",
      "title": "Statement Registry Ref",
      "type": "string"
    },
    "verification_id": {
      "pattern": "^claim-verification:[a-f0-9]{16}$",
      "title": "Verification Id",
      "type": "string"
    },
    "verifier_version": {
      "const": "0.1.0",
      "title": "Verifier Version",
      "type": "string"
    }
  },
  "required": [
    "object_version",
    "verification_id",
    "verifier_version",
    "benchmark_id",
    "benchmark_sha256",
    "release_contract_id",
    "release_contract_sha256",
    "report_draft_ref",
    "report_content_hash",
    "claim_policy_ref",
    "statement_registry_ref",
    "release_state",
    "check_records",
    "claim_evidence_map",
    "public_export_eligibility"
  ],
  "title": "ClaimVerificationResult",
  "type": "object"
}
