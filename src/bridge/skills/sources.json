  "workflows": {
    "case-understanding": {
      "sources": [
        "kd-design",
        "tu-datasets"
      ],
      "bridge_reuse": [
        "web/intake.py",
        "web/clarification.py",
        "web/service.py"
      ],
      "excluded": "No new study allocation engine, direct search or invented sample relationships."
    },
    "expression-exploration": {
      "sources": [
        "tu-single-cell"
      ],
      "bridge_reuse": [
        "tool_packages/p0_01_input_qc",
        "tool_packages/p0_02_cell_state",
        "tool_packages/p0_07_product_comparison_stability"
      ],
      "excluded": "No direct Scanpy/R script calls, fixed QC thresholds or filename-based result authority."
    },
    "reference-and-target-definition": {
      "sources": [
        "tu-stem-cell",
        "kd-census"
      ],
      "bridge_reuse": [
        "web/scientific_inputs.py",
        "tool_packages/p0_02_cell_state"
      ],
      "excluded": "No live atlas import, automatic marker-based identity or default maturity window."
    },
    "product-assessment": {
      "sources": [
        "tu-stem-cell"
      ],
      "bridge_reuse": [
        "web/assessment.py",
        "tool_packages/p0_03_target_regional",
        "tool_packages/p0_04_developmental_compatibility",
        "tool_packages/p0_05_off_target_control",
        "tool_packages/p0_06_proliferation_stress_response"
      ],
      "excluded": "No upstream fidelity score, fixed marker count or differentiation intervention prescription."
    },
    "evidence-reasoning": {
      "sources": [
        "kd-hypotheses",
        "kd-appraisal"
      ],
      "bridge_reuse": [
        "web/provider.py",
        "web/assessment.py",
        "tool_packages/p0_08_evidence_sufficiency",
        "tool_packages/p0_09_evidence_compiler"
      ],
      "excluded": "No independent hypothesis schema, confidence score, unregistered test or formal GRADE rating."
    },
    "research-reporting": {
      "sources": [
        "kd-writing",
        "tu-literature"
      ],
      "bridge_reuse": [
        "web/assessment.py",
        "tool_packages/p0_10_claim_verifier"
      ],
      "excluded": "No manuscript scaffold, mandatory section quota, automatic live search or external publication."
    },
    "product-comparison": {
      "sources": [
        "kd-design",
        "kd-statistics"
      ],
      "bridge_reuse": [
        "tool_packages/p0_07_product_comparison_stability",
        "web/inputs.py"
      ],
      "excluded": "No new t-test/ANOVA engine, inferred replicates, unsupported intervals or product ranking."
    },
    "graft-followup": {
      "sources": [
        "kd-design",
        "kd-appraisal",
        "tu-stem-cell"
      ],
      "bridge_reuse": [
        "tool_packages/p0_12_graft_assessment"
      ],
      "excluded": "No efficacy/safety inference, automatic state classifier or pre-transplant backfill."
    }
  }
}
